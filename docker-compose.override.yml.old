services:
  becpg:
    # PINNED to what was actually running before this override existed.
    # target/docker-compose.yml says `becpg/becpg-test-core`, but the live stack runs the
    # ENTERPRISE image (it carries becpg-artworks and the AIMS filter). Without this pin a
    # `docker compose up` silently swaps the repository image.
    image: becpg/becpg-enterprise-test-core:26.1.0.25-SNAPSHOT
    # The Keycloak issuer has to be ONE url for everybody: the host browser, the portal
    # (a host process) and the containers. becpg.local already resolves to 172.18.0.1 in the
    # host /etc/hosts, and 172.18.0.1 is this compose network's gateway, so the very same
    # http://becpg.local:8081/auth works from inside a container.
    extra_hosts:
      - "becpg.local:172.18.0.1"
    # NOTE: CATALINA_OPTS below is a YAML folded block (`>-`). A `#` inside it is NOT a
    # comment — it is passed straight to the JVM and the container dies printing java usage.
    # Keep every explanation OUT of that block.
    #
    # identity-service.authentication.enable-username-password-authentication is OFF on
    # purpose: with it on, EVERY username/password login first attempts a Keycloak password
    # grant, which fails for local-only accounts (admin, the test users) before falling
    # through to alfrescoNtlm. Measured: a plain ticket login went from ~0.05 s to 1.3 s,
    # enough to make the e2e suite crawl. Bearer tokens never go through that handler, so the
    # OIDC token -> Alfresco ticket exchange is unaffected.
    environment:
      CATALINA_OPTS: >-
        -Xmx4G
        -Duser.language=fr
        -Duser.country=FR
        -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=0.0.0.0:8888
        -Dcom.sun.management.jmxremote.rmi.port=9091
        -Dcom.sun.management.jmxremote=true
        -Dcom.sun.management.jmxremote.port=9091
        -Dcom.sun.management.jmxremote.ssl=false
        -Dcom.sun.management.jmxremote.authenticate=false
        -Dcom.sun.management.jmxremote.local.only=false
        -Djava.rmi.server.hostname=127.0.0.1
        -Dtomcat.util.scan.StandardJarScanFilter.jarsToSkip=*
        --add-opens=java.base/jdk.internal.loader=ALL-UNNAMED
        --add-opens=java.base/java.lang=ALL-UNNAMED
        --add-opens=java.base/java.io=ALL-UNNAMED
        --add-opens=java.base/java.util=ALL-UNNAMED
        --add-opens=java.base/java.net=ALL-UNNAMED
        -Dauthentication.chain=identity-service1:identity-service,alfrescoNtlm1:alfrescoNtlm
        -Didentity-service.auth-server-url=http://becpg.local:8081/auth
        -Didentity-service.realm=inst1
        -Didentity-service.resource=inst1-openid
        -Didentity-service.public-client=false
        -Didentity-service.credentials.secret=changeit
        -Didentity-service.authentication.enabled=true
        -Didentity-service.authentication.enable-username-password-authentication=false
        -Didentity-service.authentication.validation.failure.silent=true
        -Dtoken.authentication.defaultAdministratorUserNames=admin,inst1-account-admin
        -Dcreate.missing.people=true
    volumes:
      - becpg_data:/usr/local/tomcat/data

#  busybox-chown:
#    image: busybox
#    volumes:
#      - becpg_data:/data2
#      - becpg_share_data:/data1
#    command: sh -c "chown -R 33000:1000 /data1 && chown -R alfresco:alfresco /data2"

  becpg-share:
    # Same pin rationale as `becpg` above: the live stack runs the enterprise Share image,
    # which is the one carrying BeCPGAIMSFilter.
    image: becpg/becpg-enterprise-test-share:26.1.0.25-SNAPSHOT
    extra_hosts:
      - "becpg.local:172.18.0.1"
    environment:
      JAVA_OPTS: "-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=0.0.0.0:8888  -Duser.language=fr -Duser.country=FR -Dtomcat.util.scan.StandardJarScanFilter.jarsToSkip=*"
      REPO_HOST: becpg
      REPO_PORT: 8080
    # Share AIMS is deliberately NOT enabled. Measured on this instance, 2026-07-30:
    #   * BeCPGAIMSFilter has no incoming-bearer branch (no `Bearer` anywhere in the class);
    #     `GET /share/page/` with a valid OIDC access token answers
    #     `302 -> /share/page/aims-login`, i.e. the token is ignored.
    #   * With it on, the filter also swallows `/share/page/dologin`, so the
    #     username/password route to a Share session disappears too.
    # It therefore costs a working fallback and buys nothing for the portal. To try it
    # again, add:
    #   BECPG_AUTH_OAUTH2: "true"
    #   OAUTH2_REALM: "inst1"
    #   OAUTH2_RESOURCE: "inst1-openid"
    #   OAUTH2_SERVER_URL: "http://becpg.local:8081/auth"
    #   OAUTH2_SECRET: "changeit"
    # (substituter.sh resets realm/resource/secret to the becpg/becpg-openid defaults
    # whenever BECPG_AUTH_OAUTH2 is false, so that flag has to come first.)

  becpg-report:
    image:  europe-west1-docker.pkg.dev/becpg-314807/becpg-docker/becpg-report:4.20.0.1
    user: root
    ports:
       - "8086:8080"

  becpg-auth:
    # Keycloak 26.5 + the beCPG login theme. Tag 25.2.1 (the one in the shipped
    # docker-compose.override.yml.auth) is not pullable; 26.1.0 is present locally.
    # start-dev + in-memory H2 on purpose: no volume, so every restart re-imports the realm.
    image: becpg/becpg-ids:26.1.0
    command: ["start-dev", "--import-realm", "--proxy-headers=forwarded"]
    environment:
      KEYCLOAK_ADMIN: inst1-account-admin
      KEYCLOAK_ADMIN_PASSWORD: becpgAdminLocal2026
      KC_BOOTSTRAP_ADMIN_USERNAME: inst1-account-admin
      KC_BOOTSTRAP_ADMIN_PASSWORD: becpgAdminLocal2026
      KC_HEALTH_ENABLED: "true"
      KC_HTTP_RELATIVE_PATH: /auth
      KC_HTTP_ENABLED: "true"
      KC_HOSTNAME: http://becpg.local:8081
      KC_HOSTNAME_STRICT: "false"
    ports:
      - "8081:8080"
    volumes:
      - /home/matthieu/becpg-workspace/becpg/becpg-integration-runner/target/oidc/inst1-realm.json:/opt/keycloak/data/import/inst1-realm.json:ro
