services:
  becpg:
    environment:
      CATALINA_OPTS: >-
        -Xmx4G
        -Duser.language=fr
        -Duser.country=FR
        -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=0.0.0.0:8888
        -Dcom.sun.management.jmxremote.rmi.port=9091
        -Dcom.sun.management.jmxremote=true
        -Dcom.sun.management.jmxremote.port=9091
        -Dcom.sun.management.jmxremote.ssl=false
        -Dcom.sun.management.jmxremote.authenticate=false
        -Dcom.sun.management.jmxremote.local.only=false
        -Djava.rmi.server.hostname=127.0.0.1
        -DbeCPG.licence.showWarning=true
        -Dtomcat.util.scan.StandardJarScanFilter.jarsToSkip=*
        # beCPG OLAP / Saiku (#24931). url.public is what the BROWSER opens: OlapServiceImpl
        # appends ?ticket= to it. url.internal is what ALFRESCO calls server to server;
        # 172.17.0.1 is the Docker host as seen from the container. The user must belong to
        # GROUP_OlapUser for the menu to show up in Share.
        -Dbecpg.olap.enabled=true
        -Dbecpg.olap.url.public=http://localhost:8085/saiku
        -Dbecpg.olap.url.internal=http://172.17.0.1:8085/saiku
        --add-opens=java.base/jdk.internal.loader=ALL-UNNAMED
        --add-opens=java.base/java.lang=ALL-UNNAMED
        --add-opens=java.base/java.io=ALL-UNNAMED
        --add-opens=java.base/java.util=ALL-UNNAMED
        --add-opens=java.base/java.net=ALL-UNNAMED
    mem_limit: 6g
    volumes:
      - becpg_data:/usr/local/tomcat/data
                 
#  busybox-chown:
#    image: busybox
#    volumes:
#      - becpg_data:/data2
#      - becpg_share_data:/data1      
#    command: sh -c "chown -R 33000:1000 /data1 && chown -R alfresco:alfresco /data2"   

  becpg-report:
    image:  europe-west1-docker.pkg.dev/becpg-314807/becpg-docker/becpg-report:4.24.0.0
    user: root
    mem_limit: 1500m
    ports:
       - "8086:8080"

