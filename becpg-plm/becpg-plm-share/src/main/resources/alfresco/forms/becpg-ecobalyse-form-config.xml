<alfresco-config>

	<!--
		Ecobalyse mapping and farming practices. The code ties an ingredient to the Ecobalyse
		reference the same way bcpg:regulatoryCode ties it to Decernis; the practices feed the
		ecosystemic services the environmental cost adds on top of the life cycle indicators.
	-->

	<config evaluator="node-type" condition="bcpg:ing" replace="false">
		<forms>
			<form>
				<field-visibility>
					<show id="bcpg:ecobalyseCode" force="true" />
				</field-visibility>
				<appearance>
					<field id="bcpg:ecobalyseCode" set="regulatory" />
				</appearance>
			</form>
		</forms>
	</config>

	<config evaluator="model-type" condition="bcpg:ing" replace="false">
		<forms>
			<form>
				<field-visibility>
					<show id="bcpg:ecobalyseCode" force="true" />
				</field-visibility>
			</form>
			<form id="datagrid">
				<field-visibility>
					<show id="bcpg:ecobalyseCode" force="true" />
				</field-visibility>
			</form>
		</forms>
	</config>

	<config evaluator="node-type" condition="bcpg:rawMaterial" replace="false">
		<forms>
			<form>
				<field-visibility>
					<show id="bcpg:ecobalyseCode" force="true" />
					<show id="bcpg:apScenario" force="true" />
					<show id="bcpg:apCropGroup" force="true" />
				</field-visibility>
				<appearance>
					<set id="ecobalyse" appearance="bordered-panel" label-id="form.set.ecobalyse" />
					<field id="bcpg:ecobalyseCode" set="ecobalyse" />
					<field id="bcpg:apScenario" set="ecobalyse" />
					<field id="bcpg:apCropGroup" set="ecobalyse" />
				</appearance>
			</form>
		</forms>
	</config>

	<!--
		The rearing step is a property of the geographic origin, which is then picked on the
		ingredient or the raw material: an origin reads "France, rearing" rather than France.
	-->

	<config evaluator="model-type" condition="bcpg:geoOrigin" replace="false">
		<forms>
			<form>
				<field-visibility>
					<show id="gs1:productActivityTypeCode" force="true" />
				</field-visibility>
			</form>
			<form id="datagrid">
				<field-visibility>
					<show id="gs1:productActivityTypeCode" force="true" />
				</field-visibility>
			</form>
		</forms>
	</config>

	<config evaluator="node-type" condition="bcpg:geoOrigin" replace="false">
		<forms>
			<form>
				<field-visibility>
					<show id="gs1:productActivityTypeCode" force="true" />
				</field-visibility>
			</form>
		</forms>
	</config>

</alfresco-config>
