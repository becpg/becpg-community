{
  "header": {
    "logo": "becpg-logo.png",
    "title": "becpg.report.productspec.title",
    "subtitle": "${legalName}",
    "date": "${cm:modified?date}",
    "startNumberingAt": 1
  },

  "tableOfContents": {
    "enabled": false
  },

  "pagination": {
    "enabled": true,
    "format": "Page ${page} / ${total}",
    "startNumberingAt": 1,
    "font": "Arial",
    "size": 8,
    "color": "#404040"
  },

  "componentHeadingStyle": {
    "font": "Arial-Bold",
    "size": 11,
    "color": "#1F3864",
    "prefix": "> "
  },

  "placeholderStyle": {
    "font": "Arial-Bold",
    "size": 9,
    "color": "#000000"
  },

  "annexes": [
    {
      "annexIdResolver": "rep:reportTplAssoc|rep:reportKinds=SupplierSheet",
      "title": "becpg.report.productspec.annex.rawmaterials.title",
      "scope": "COMPO_CHILDREN",
      "recurse": true,
      "componentTypes": ["bcpg:rawMaterial", "bcpg:semiFinishedProduct"],
      "componentHeading": true,
      "emptyPlaceholder": "becpg.report.productspec.annex.rawmaterials.placeholder",
      "sort": "COMPO_ORDER",
      "dedup": true,
      "required": true,
      "mimeTypes": ["application/pdf"]
    },
    {
      "annexIdResolver": "rep:reportTplAssoc|rep:reportKinds=PackagingSheet",
      "title": "becpg.report.productspec.annex.primarypackaging.title",
      "scope": "PACKAGING_CHILDREN",
      "pkgLevel": "Primary",
      "componentHeading": true,
      "emptyPlaceholder": "becpg.report.productspec.annex.primarypackaging.placeholder",
      "sort": "COMPO_ORDER",
      "dedup": true,
      "required": true,
      "mimeTypes": ["application/pdf"]
    },
    {
      "annexIdResolver": "rep:reportTplAssoc|rep:reportKinds=PackagingSheet",
      "title": "becpg.report.productspec.annex.secondarypackaging.title",
      "scope": "PACKAGING_CHILDREN",
      "pkgLevel": "Secondary",
      "componentHeading": true,
      "emptyPlaceholder": "becpg.report.productspec.annex.secondarypackaging.placeholder",
      "sort": "COMPO_ORDER",
      "dedup": true,
      "required": true,
      "mimeTypes": ["application/pdf"]
    },
    {
      "annexIdResolver": "bcpg:documentTypeRef|cm:name=Photos",
      "title": "becpg.report.productspec.annex.photos.title",
      "scope": "ENTITY",
      "componentHeading": false,
      "emptyPlaceholder": "becpg.report.productspec.annex.photos.placeholder",
      "required": true,
      "mimeTypes": ["application/pdf", "image/png", "image/jpeg"]
    },
    {
      "annexIdResolver": "bcpg:documentTypeRef|cm:name=QualityDocuments",
      "title": "becpg.report.productspec.annex.qualitydocuments.title",
      "scope": "ENTITY",
      "componentHeading": false,
      "emptyPlaceholder": "becpg.report.productspec.annex.qualitydocuments.placeholder",
      "required": true,
      "mimeTypes": ["application/pdf"]
    },
    {
      "annexIdResolver": "bcpg:documentTypeRef|cm:name=Subcontractors",
      "title": "becpg.report.productspec.annex.subcontractors.title",
      "scope": "ENTITY",
      "componentHeading": false,
      "emptyPlaceholder": "becpg.report.productspec.annex.subcontractors.placeholder",
      "required": true,
      "mimeTypes": ["application/pdf"]
    }
  ]
}
