<?xml version="1.0" encoding="UTF-8"?>
<report xmlns="http://www.eclipse.org/birt/2005/design" version="3.2.23" id="1">
    <property name="author">beCPG</property>
    <property name="units">in</property>
    <property name="comments">Ticket #32570 - regulatory nutrition facts panels.
Each panel is rendered by a labeling rule as SVG, streamed to the report engine as an
in-memory image and embedded here as vector graphics, which is what keeps the typography
and the rules of a regulated panel exact in the PDF.</property>
    <data-sources>
        <oda-data-source extensionID="org.eclipse.datatools.enablement.oda.xml" name="DataXml" id="4">
            <property name="FILELIST">src/main/resources/beCPG/birt/document/product/default/ProductReport.xml</property>
        </oda-data-source>
    </data-sources>
    <data-sets>
        <oda-data-set extensionID="org.eclipse.datatools.enablement.oda.xml.dataSet" name="dsNutritionFacts" id="5">
            <property name="nullsOrdering">nulls lowest</property>
            <list-property name="parameters"/>
            <property name="dataSource">DataXml</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">imageId</property>
                    <property name="nativeName">imageId</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">code</property>
                    <property name="nativeName">code</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">locale</property>
                    <property name="nativeName">locale</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[table0#-TNAME-#table0#:#[/entity/nutritionFacts/nutritionFact]#:#{imageId;STRING;/@imageId},{code;STRING;/@code},{locale;STRING;/@locale}]]></xml-property>
            <list-property name="privateDriverProperties">
                <ex-property>
                    <name>MAX_ROW</name>
                    <value>-1</value>
                </ex-property>
                <ex-property>
                    <name>XML_FILE</name>
                </ex-property>
            </list-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.datatools.enablement.oda.xml.dataSet" name="dsProduct" id="6">
            <property name="nullsOrdering">nulls lowest</property>
            <list-property name="parameters"/>
            <property name="dataSource">DataXml</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">name</property>
                    <property name="nativeName">name</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">code</property>
                    <property name="nativeName">code</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[table0#-TNAME-#table0#:#[/entity]#:#{name;STRING;/@name},{code;STRING;/@code}]]></xml-property>
            <list-property name="privateDriverProperties">
                <ex-property>
                    <name>MAX_ROW</name>
                    <value>1</value>
                </ex-property>
                <ex-property>
                    <name>XML_FILE</name>
                </ex-property>
            </list-property>
        </oda-data-set>
    </data-sets>
    <page-setup>
        <simple-master-page name="Simple MasterPage" id="2">
            <property name="topMargin">0.5in</property>
            <property name="leftMargin">0.6in</property>
            <property name="bottomMargin">0.5in</property>
            <property name="rightMargin">0.6in</property>
            <page-header>
                <text id="3">
                    <property name="contentType">html</property>
                    <property name="fontSize">8pt</property>
                    <text-property name="content">Nutrition Facts - #32570</text-property>
                </text>
            </page-header>
        </simple-master-page>
    </page-setup>
    <body>
        <text id="10">
            <property name="contentType">html</property>
            <property name="fontSize">16pt</property>
            <property name="fontWeight">bold</property>
            <property name="marginBottom">6pt</property>
            <text-property name="content">Regulatory nutrition facts panels</text-property>
        </text>
        <table id="20">
            <property name="width">100%</property>
            <property name="dataSet">dsProduct</property>
            <column id="21"/>
            <detail>
                <row id="22">
                    <cell id="23">
                        <data id="24">
                            <property name="fontSize">10pt</property>
                            <property name="marginBottom">10pt</property>
                            <property name="resultSetColumn">name</property>
                        </data>
                    </cell>
                </row>
            </detail>
            <list-property name="boundDataColumns">
                <structure>
                    <property name="name">name</property>
                    <expression name="expression" type="javascript">dataSetRow["name"]</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
        </table>
        <list id="30">
            <property name="dataSet">dsNutritionFacts</property>
            <list-property name="boundDataColumns">
                <structure>
                    <property name="name">code</property>
                    <expression name="expression" type="javascript">dataSetRow["code"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">locale</property>
                    <expression name="expression" type="javascript">dataSetRow["locale"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">panel</property>
                    <expression name="expression" type="javascript">reportContext.getAppContext().get(dataSetRow["imageId"]);</expression>
                    <property name="dataType">blob</property>
                    <property name="allowExport">true</property>
                </structure>
            </list-property>
            <list-property name="filter">
                <structure>
                    <property name="operator">eq</property>
                    <expression name="expr" type="javascript">row["locale"]</expression>
                    <expression name="value1" type="javascript">"en"</expression>
                </structure>
            </list-property>
            <detail>
                <text id="31">
                    <property name="contentType">html</property>
                    <property name="fontSize">9pt</property>
                    <property name="fontWeight">bold</property>
                    <property name="marginTop">12pt</property>
                    <property name="marginBottom">3pt</property>
                    <text-property name="content"><![CDATA[<value-of>row["code"]</value-of>]]></text-property>
                </text>
                <image id="100">
                    <property name="source">expr</property>
                    <expression name="valueExpr" type="javascript">row["panel"]</expression>
                    <expression name="typeExpr" type="javascript">"image/svg+xml"</expression>
                    <property name="width">3.8in</property>
                    <property name="height">4.803in</property>
                    <property name="fitToContainer">false</property>
                    <list-property name="visibility">
                        <structure>
                            <property name="format">all</property>
                            <expression name="valueExpr" type="javascript">row["code"] != "Canada_Dual_column"</expression>
                        </structure>
                    </list-property>
                </image>
                <image id="101">
                    <property name="source">expr</property>
                    <expression name="valueExpr" type="javascript">row["panel"]</expression>
                    <expression name="typeExpr" type="javascript">"image/svg+xml"</expression>
                    <property name="width">2.9in</property>
                    <property name="height">3.373in</property>
                    <property name="fitToContainer">false</property>
                    <list-property name="visibility">
                        <structure>
                            <property name="format">all</property>
                            <expression name="valueExpr" type="javascript">row["code"] != "Canada_Linear"</expression>
                        </structure>
                    </list-property>
                </image>
                <image id="102">
                    <property name="source">expr</property>
                    <expression name="valueExpr" type="javascript">row["panel"]</expression>
                    <expression name="typeExpr" type="javascript">"image/svg+xml"</expression>
                    <property name="width">2.9in</property>
                    <property name="height">5.694in</property>
                    <property name="fitToContainer">false</property>
                    <list-property name="visibility">
                        <structure>
                            <property name="format">all</property>
                            <expression name="valueExpr" type="javascript">row["code"] != "Canada_Standard"</expression>
                        </structure>
                    </list-property>
                </image>
                <image id="103">
                    <property name="source">expr</property>
                    <expression name="valueExpr" type="javascript">row["panel"]</expression>
                    <expression name="typeExpr" type="javascript">"image/svg+xml"</expression>
                    <property name="width">5.0in</property>
                    <property name="height">2.578in</property>
                    <property name="fitToContainer">false</property>
                    <list-property name="visibility">
                        <structure>
                            <property name="format">all</property>
                            <expression name="valueExpr" type="javascript">row["code"] != "Canada_Tabular"</expression>
                        </structure>
                    </list-property>
                </image>
                <image id="104">
                    <property name="source">expr</property>
                    <expression name="valueExpr" type="javascript">row["panel"]</expression>
                    <expression name="typeExpr" type="javascript">"image/svg+xml"</expression>
                    <property name="width">2.9in</property>
                    <property name="height">6.137in</property>
                    <property name="fitToContainer">false</property>
                    <list-property name="visibility">
                        <structure>
                            <property name="format">all</property>
                            <expression name="valueExpr" type="javascript">row["code"] != "FDA"</expression>
                        </structure>
                    </list-property>
                </image>
                <image id="105">
                    <property name="source">expr</property>
                    <expression name="valueExpr" type="javascript">row["panel"]</expression>
                    <expression name="typeExpr" type="javascript">"image/svg+xml"</expression>
                    <property name="width">3.8in</property>
                    <property name="height">5.049in</property>
                    <property name="fitToContainer">false</property>
                    <list-property name="visibility">
                        <structure>
                            <property name="format">all</property>
                            <expression name="valueExpr" type="javascript">row["code"] != "FDA_Dual_column"</expression>
                        </structure>
                    </list-property>
                </image>
                <image id="106">
                    <property name="source">expr</property>
                    <expression name="valueExpr" type="javascript">row["panel"]</expression>
                    <expression name="typeExpr" type="javascript">"image/svg+xml"</expression>
                    <property name="width">2.9in</property>
                    <property name="height">3.877in</property>
                    <property name="fitToContainer">false</property>
                    <list-property name="visibility">
                        <structure>
                            <property name="format">all</property>
                            <expression name="valueExpr" type="javascript">row["code"] != "FDA_Linear"</expression>
                        </structure>
                    </list-property>
                </image>
                <image id="107">
                    <property name="source">expr</property>
                    <expression name="valueExpr" type="javascript">row["panel"]</expression>
                    <expression name="typeExpr" type="javascript">"image/svg+xml"</expression>
                    <property name="width">2.9in</property>
                    <property name="height">5.684in</property>
                    <property name="fitToContainer">false</property>
                    <list-property name="visibility">
                        <structure>
                            <property name="format">all</property>
                            <expression name="valueExpr" type="javascript">row["code"] != "FDA_Side_by_side"</expression>
                        </structure>
                    </list-property>
                </image>
                <image id="108">
                    <property name="source">expr</property>
                    <expression name="valueExpr" type="javascript">row["panel"]</expression>
                    <expression name="typeExpr" type="javascript">"image/svg+xml"</expression>
                    <property name="width">2.9in</property>
                    <property name="height">6.303in</property>
                    <property name="fitToContainer">false</property>
                    <list-property name="visibility">
                        <structure>
                            <property name="format">all</property>
                            <expression name="valueExpr" type="javascript">row["code"] != "FDA_Simplified"</expression>
                        </structure>
                    </list-property>
                </image>
                <image id="109">
                    <property name="source">expr</property>
                    <expression name="valueExpr" type="javascript">row["panel"]</expression>
                    <expression name="typeExpr" type="javascript">"image/svg+xml"</expression>
                    <property name="width">5.0in</property>
                    <property name="height">2.7in</property>
                    <property name="fitToContainer">false</property>
                    <list-property name="visibility">
                        <structure>
                            <property name="format">all</property>
                            <expression name="valueExpr" type="javascript">row["code"] != "FDA_Tabular"</expression>
                        </structure>
                    </list-property>
                </image>
            </detail>
        </list>
    </body>
</report>
