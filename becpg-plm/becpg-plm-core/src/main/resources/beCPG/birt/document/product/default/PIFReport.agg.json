    "size": 8,
    "color": "#404040"
  },

  "componentHeadingStyle": {
    "font": "Arial-Bold",
    "size": 11,
    "color": "#004254",
    "prefix": "> "
  },

  "placeholderStyle": {
    "font": "Arial-Bold",
    "size": 9,
    "color": "#000000"
  },

