<?xml version="1.0" encoding="UTF-8"?>
<report xmlns="http://www.eclipse.org/birt/2005/design" version="3.2.23" id="1">
    <property name="author">beCPG</property>
    <property name="createdBy">Eclipse BIRT Designer Version 4.7.0</property>
    <simple-property-list name="includeResource">
        <value>./ProductReport</value>
        <value>./PIFReport</value>
    </simple-property-list>
    <property name="units">in</property>
    <list-property name="cssStyleSheets">
        <structure>
            <property name="fileName">becpg-report.css</property>
            <property name="useExternalCss">true</property>
        </structure>
    </list-property>
    <data-sources>
        <oda-data-source extensionID="org.eclipse.datatools.enablement.oda.xml" name="DataXml" id="452">
            <property name="FILELIST">beCPG/birt/document/product/default/ProductReport.xml</property>
        </oda-data-source>
    </data-sources>
    <data-sets>
        <oda-data-set extensionID="org.eclipse.datatools.enablement.oda.xml.dataSet" name="Product" id="453">
            <property name="nullsOrdering">nulls lowest</property>
            <list-property name="computedColumns">
                <structure>
                    <property name="name">versionLabelToShow</property>
                    <expression name="expression">if(row["versionLabelBcpg"] != null){
	row["versionLabelBcpg"]
} else if(row["versionLabel"] != null){
	row["versionLabel"]
} else "1.0"</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">fullProductTitle</property>
                    <expression name="expression">var n = row["name"] != null ? row["name"] : "";
var c = row["code"] != null ? " - " + row["code"] : "";
n + c;</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">codeAndVersion</property>
                    <expression name="expression">var c = row["code"] != null ? row["code"] : "";
var v = row["versionLabelToShow"] != null ? " (" + row["versionLabelToShow"] + ")" : "";
c + v;</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">netContent</property>
                    <expression name="expression">var parts = [];
if (row["netVolume"] != null) {
	parts.push(row["netVolume"] + " L");
}
if (row["netWeight"] != null) {
	parts.push(row["netWeight"] + " kg");
}
parts.join(" / ");</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="dataSource">DataXml</property>
            <xml-property name="queryText"><![CDATA[table0#-TNAME-#table0#:#[/entity]#:#{code;STRING;/code},{name;STRING;/name},{title;STRING;/title},{legalName;STRING;/legalName},{description;STRING;/description},{preparationTips;STRING;/preparationTips},{storageConditionsDescription;STRING;/storageConditions/description},{precautionOfUseDescription;STRING;/precautionOfUse/description},{versionLabel;STRING;/versionLabel},{versionLabelBcpg;STRING;/versionLabel[@prefix='bcpg']},{productState;STRING;/productState},{modified;TIMESTAMP;/modified},{created;TIMESTAMP;/created},{creator;STRING;/creator},{modifier;STRING;/modifier},{netWeight;DOUBLE;/netWeight},{productUnit;STRING;/productUnit},{productHierarchy1;STRING;/productHierarchy1},{productHierarchy2;STRING;/productHierarchy2},{eanCode;STRING;/eanCode},{erpCode;STRING;/erpCode},{netVolume;STRING;/netVolume},{periodAfterOpening;STRING;/periodAfterOpening},{regulatoryUseMode;STRING;/regulatoryUseMode/@translation},{regulatoryApplicationZones;STRING;/regulatoryApplicationZones/@translation},{regulatoryMucousContact;STRING;/regulatoryMucousContact},{subsidiaryRef;STRING;/subsidiaryRef/subsidiary/name},{responsiblePersonAddress;STRING;/subsidiaryRef/subsidiary/locationAddress1}]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.datatools.enablement.oda.xml.dataSet" name="pifPlants" id="460">
            <property name="dataSource">DataXml</property>
            <xml-property name="queryText"><![CDATA[table0#-TNAME-#table0#:#[/entity/plants/plant]#:#{name;STRING;/name},{locationAddress1;STRING;/locationAddress1},{plantCertifications;STRING;/plantCertifications}]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.datatools.enablement.oda.xml.dataSet" name="pifProcessSteps" id="461">
            <property name="dataSource">DataXml</property>
            <xml-property name="queryText"><![CDATA[table0#-TNAME-#table0#:#[/entity/dataLists/processLists/processList]#:#{plStep;STRING;/@plStep},{stepDescription;STRING;/plStep/processStep/description}]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.datatools.enablement.oda.xml.dataSet" name="pifPhysicoChems" id="462">
            <list-property name="computedColumns">
                <structure>
                    <property name="name">valueText</property>
                    <expression name="expression">row["pclValue"] != null ? String(Math.round(row["pclValue"] * 1000) / 1000) : ""</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">miniText</property>
                    <expression name="expression">row["pclMini"] != null ? String(Math.round(row["pclMini"] * 1000) / 1000) : ""</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">maxiText</property>
                    <expression name="expression">row["pclMaxi"] != null ? String(Math.round(row["pclMaxi"] * 1000) / 1000) : ""</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="dataSource">DataXml</property>
            <xml-property name="queryText"><![CDATA[table0#-TNAME-#table0#:#[/entity/dataLists/physicoChemLists/physicoChemList]#:#{pclPhysicoChem;STRING;/@pclPhysicoChem},{pclValue;DOUBLE;/@pclValue},{pclUnit;STRING;/@pclUnit},{pclMini;DOUBLE;/@pclMini},{pclMaxi;DOUBLE;/@pclMaxi}]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.datatools.enablement.oda.xml.dataSet" name="pifMicrobios" id="463">
            <list-property name="computedColumns">
                <structure>
                    <property name="name">maxiText</property>
                    <expression name="expression">row["mblMaxi"] != null ? String(Math.round(row["mblMaxi"] * 1000) / 1000) : ""</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="dataSource">DataXml</property>
            <xml-property name="queryText"><![CDATA[table0#-TNAME-#table0#:#[/entity/dataLists/microbioLists/microbioList]#:#{mblMicrobio;STRING;/@mblMicrobio},{mblMaxi;DOUBLE;/@mblMaxi},{mblUnit;STRING;/@mblUnit},{mblTextCriteria;STRING;/@mblTextCriteria}]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.datatools.enablement.oda.xml.dataSet" name="pifIngLabeling" id="464">
            <list-property name="computedColumns">
                <structure>
                    <property name="name">illValueToShow</property>
                    <expression name="expression">row["illManualValue"] != null &amp;&amp; row["illManualValue"] != "" ? row["illManualValue"] : row["illValue"]</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="dataSource">DataXml</property>
            <xml-property name="queryText"><![CDATA[table0#-TNAME-#table0#:#[/entity/dataLists/ingLabelingLists/ingLabelingList]#:#{languageCode;STRING;/@languageCode},{illValue;STRING;/illValue},{illManualValue;STRING;/illManualValue}]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.datatools.enablement.oda.xml.dataSet" name="pifClaims" id="465">
            <list-property name="computedColumns">
                <structure>
                    <property name="name">claimValueText</property>
                    <expression name="expression">row["lclClaimValueTranslation"] != null &amp;&amp; row["lclClaimValueTranslation"] != "" ? row["lclClaimValueTranslation"] : row["lclClaimValue"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">percentClaimText</property>
                    <expression name="expression">row["lclPercentClaim"] != null ? String(Math.round(row["lclPercentClaim"] * 1000) / 1000) : ""</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="dataSource">DataXml</property>
            <xml-property name="queryText"><![CDATA[table0#-TNAME-#table0#:#[/entity/dataLists/labelClaimLists/labelClaimList]#:#{lclLabelClaim;STRING;/@lclLabelClaim},{lclClaimValue;STRING;/@lclClaimValue},{lclClaimValueTranslation;STRING;/@lclClaimValueTranslation},{lclPercentClaim;DOUBLE;/@lclPercentClaim}]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.datatools.enablement.oda.xml.dataSet" name="pifAllergens" id="466">
            <list-property name="computedColumns">
                <structure>
                    <property name="name">qtyPercText</property>
                    <expression name="expression">row["allergenListQtyPerc"] != null ? String(Math.round(row["allergenListQtyPerc"] * 1000000) / 1000000) : ""</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">thresholdText</property>
                    <expression name="expression">row["allergenRegulatoryThreshold"] != null ? String(Math.round(row["allergenRegulatoryThreshold"] * 1000000) / 1000000) : ""</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="dataSource">DataXml</property>
            <xml-property name="queryText"><![CDATA[table0#-TNAME-#table0#:#[/entity/dataLists/allergenLists/allergenList]#:#{allergenListAllergen;STRING;/@allergenListAllergen},{allergenListQtyPerc;DOUBLE;/@allergenListQtyPerc},{allergenListVoluntary;STRING;/@allergenListVoluntary},{allergenListInVoluntary;STRING;/@allergenListInVoluntary},{allergenRegulatoryThreshold;DOUBLE;/@allergenRegulatoryThreshold}]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.datatools.enablement.oda.xml.dataSet" name="pifToxicology" id="467">
            <list-property name="computedColumns">
                <structure>
                    <property name="name">maxConcentrationText</property>
                    <expression name="expression">row["toxListValue"] != null ? String(Math.round(row["toxListValue"] * 100) / 100) : ""</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="dataSource">DataXml</property>
            <xml-property name="queryText"><![CDATA[table0#-TNAME-#table0#:#[/entity/dataLists/toxLists/toxList]#:#{toxListTox;STRING;/@toxListTox},{toxListValue;DOUBLE;/@toxListValue}]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.datatools.enablement.oda.xml.dataSet" name="imgLogo" id="12186">
            <property name="nullsOrdering">nulls lowest</property>
            <property name="dataSource">DataXml</property>
            <xml-property name="queryText"><![CDATA[table0#-TNAME-#table0#:#[/entity/images/image]#:#{id;STRING;/@id},{entityName;STRING;/@entityName},{name;STRING;/@name},{entityType;STRING;/@entityType}]]></xml-property>
        </oda-data-set>
    </data-sets>
