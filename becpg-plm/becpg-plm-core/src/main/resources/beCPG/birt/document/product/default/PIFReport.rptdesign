                                 <structure>
                                     <property name="name">toBeLabeled</property>
                                     <expression name="expression" type="javascript">row["allergenRegulatoryThreshold"] == null || row["allergenListQtyPerc"] == null ? "" : reportContext.getMessage(row["allergenListQtyPerc"] &gt; row["allergenRegulatoryThreshold"] ? "yes" : "no", reportContext.getLocale())</expression>
