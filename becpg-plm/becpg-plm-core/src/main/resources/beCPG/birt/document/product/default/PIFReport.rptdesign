                    </label>
                </cell>
                <cell id="211">
                    <label id="212">
                        <property name="style">becpg-toc-page</property>
                        <property name="noWrap">true</property>
                        <text-property name="text">{{page:CompoQualiQuanti}}</text-property>
                    </label>
                </cell>
            </row>

            <!-- Annex 2: Raw Materials -->
            <row id="213">
                <property name="style">becpg-row-border</property>
                <cell id="214">
                    <label id="215">
                        <property name="style">becpg-toc-title</property>
                        <text-property name="text" key="becpg.report.pif.annex.rawmaterials.title">ANNEX 2: RAW MATERIAL TECHNICAL &amp; SAFETY DATA SHEETS</text-property>
                    </label>
                </cell>
                <cell id="216">
                    <label id="217">
                        <property name="style">becpg-toc-page</property>
                        <property name="noWrap">true</property>
                        <text-property name="text">{{page:SupplierSheet}}</text-property>
                    </label>
                </cell>
            </row>

            <!-- Annex 3: Packaging -->
            <row id="218">
                <property name="style">becpg-row-border</property>
                <cell id="219">
                    <label id="220">
                        <property name="style">becpg-toc-title</property>
                        <text-property name="text" key="becpg.report.pif.annex.primarypackaging.title">ANNEX 3: PACKAGING SPECIFICATIONS &amp; FOOD/COSMETIC CONTACT</text-property>
                    </label>
                </cell>
                <cell id="221">
                    <label id="222">
                        <property name="style">becpg-toc-page</property>
                        <property name="noWrap">true</property>
                        <text-property name="text">{{page:PackagingSheet}}</text-property>
                    </label>
                </cell>
            </row>

            <!-- Annex 4: CPSR / DSE -->
            <row id="223">
                <property name="style">becpg-row-border</property>
                <cell id="224">
                    <label id="225">
                        <property name="style">becpg-toc-title</property>
                        <text-property name="text" key="becpg.report.pif.annex.cpsr.title">ANNEX 4: COSMETIC PRODUCT SAFETY REPORT (CPSR)</text-property>
                    </label>
                </cell>
