                                    </cell>
                                </row>
                            </grid>
                        </cell>
                    </row>
                </grid>
            </page-header>
        </simple-master-page>
    </page-setup>
    <body>
        <!-- Page 1: Table of Contents Banner -->
        <grid id="100">
            <property name="width">100%</property>
            <column id="101"/>
            <row id="102">
                <cell id="103">
                    <property name="style">becpg-chapter-header</property>
                    <label id="104">
                        <property name="style">becpg-chapter-header</property>
                        <text-property name="text" key="becpg.report.pif.toc.title">TABLE OF CONTENTS</text-property>
                    </label>
                </cell>
            </row>
        </grid>

        <grid id="200">
            <property name="width">100%</property>
            <property name="marginTop">10pt</property>
            <column id="201">
                <property name="width">65%</property>
            </column>
            <column id="202">
                <property name="width">35%</property>
            </column>
            
            <!-- Summary Body -->
            <row id="203">
                <property name="style">becpg-row-border</property>
                <cell id="204">
                    <label id="205">
                        <property name="style">becpg-toc-title</property>
                        <text-property name="text" key="becpg.report.pif.summary.title">PRODUCT INFORMATION FILE SUMMARY</text-property>
                    </label>
                </cell>
                <cell id="206">
                    <label id="207">
                        <property name="style">becpg-toc-page</property>
                        <property name="noWrap">true</property>
                        <text-property name="text">2</text-property>
                    </label>
                </cell>
            </row>

            <!-- Annex 1: Compo Quali-Quanti -->
            <row id="208">
                <property name="style">becpg-row-border</property>
                <cell id="209">
                    <label id="210">
                        <property name="style">becpg-toc-title</property>
