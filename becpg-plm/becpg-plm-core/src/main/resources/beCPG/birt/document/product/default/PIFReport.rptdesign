                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">regulatoryMucousContact</property>
                    <expression name="expression" type="javascript">if (dataSetRow["regulatoryMucousContact"] == "true") {
	reportContext.getMessage("yes", reportContext.getLocale());
} else if (dataSetRow["regulatoryMucousContact"] == "false") {
	reportContext.getMessage("no", reportContext.getLocale());
} else {
	dataSetRow["regulatoryMucousContact"];
}</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">periodAfterOpening</property>
                    <expression name="expression" type="javascript">dataSetRow["periodAfterOpening"]</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
