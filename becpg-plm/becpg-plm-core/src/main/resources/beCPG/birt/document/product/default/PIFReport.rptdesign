    <page-setup>
        <simple-master-page name="Simple MasterPage" id="10">
            <property name="type">a4</property>
            <property name="orientation">portrait</property>
            <property name="topMargin">1cm</property>
            <property name="leftMargin">1.5cm</property>
            <property name="bottomMargin">0.4cm</property>
            <property name="rightMargin">1.5cm</property>
            <property name="headerHeight">1.2in</property>
            <property name="footerHeight">0.3in</property>
            <page-header>
                <grid id="765">
                    <property name="style">becpg-header-table</property>
                    <column id="766"/>
                    <column id="767">
                        <property name="width">50%</property>
                    </column>
                    <column id="768"/>
                    <row id="769">
                        <cell id="770">
                            <property name="paddingLeft">1pt</property>
                            <property name="textAlign">left</property>
                            <image name="customLogo" id="12231">
                                <property name="height">0.8in</property>
                                <property name="dataSet">imgLogo</property>
                                <list-property name="boundDataColumns">
                                    <structure>
                                        <property name="name">img</property>
                                        <text-property name="displayName">img</text-property>
                                        <expression name="expression" type="javascript">reportContext.getAppContext().get("logo.png");</expression>
                                        <property name="dataType">blob</property>
                                        <property name="allowExport">true</property>
                                    </structure>
                                </list-property>
                                <property name="source">expr</property>
                                <expression name="valueExpr">row["img"]</expression>
                            </image>
                        </cell>
                        <cell id="772">
                            <label id="773">
                                <property name="style">becpg-header-type</property>
                                <text-property name="text" key="becpg.report.pif.title">PRODUCT INFORMATION FILE (PIF)</text-property>
                            </label>
                            <data id="3333">
                                <property name="style">becpg-header-title</property>
                                <property name="fontSize">9pt</property>
                                <property name="dataSet">Product</property>
                                <list-property name="boundDataColumns">
                                    <structure>
                                        <property name="name">title</property>
                                        <expression name="expression" type="javascript">if(dataSetRow["title"] != null &amp;&amp; dataSetRow["title"] != ""){ dataSetRow["title"] } else { dataSetRow["name"] }</expression>
                                        <property name="dataType">string</property>
                                    </structure>
                                </list-property>
                                <property name="resultSetColumn">title</property>
                            </data>
                        </cell>
                        <cell id="776">
                            <grid id="777">
                                <property name="style">becpg-meta-grid</property>
                                <property name="dataSet">Product</property>
                                <list-property name="boundDataColumns">
                                    <structure>
                                        <property name="name">created</property>
                                        <text-property name="displayName">created</text-property>
                                        <expression name="expression" type="javascript">dataSetRow["created"]</expression>
                                        <property name="dataType">date-time</property>
                                    </structure>
                                    <structure>
                                        <property name="name">modified</property>
                                        <text-property name="displayName">modified</text-property>
                                        <expression name="expression" type="javascript">dataSetRow["modified"]</expression>
                                        <property name="dataType">date-time</property>
                                    </structure>
                                    <structure>
                                        <property name="name">code</property>
                                        <text-property name="displayName">code</text-property>
                                        <expression name="expression" type="javascript">dataSetRow["code"]</expression>
                                        <property name="dataType">string</property>
                                    </structure>
                                    <structure>
                                        <property name="name">versionLabelToShow</property>
                                        <text-property name="displayName">versionLabelToShow</text-property>
                                        <expression name="expression" type="javascript">dataSetRow["versionLabelToShow"]</expression>
                                        <property name="dataType">string</property>
                                    </structure>
                                    <structure>
                                        <property name="name">erpCode</property>
                                        <text-property name="displayName">erpCode</text-property>
                                        <expression name="expression" type="javascript">dataSetRow["erpCode"]</expression>
                                        <property name="dataType">string</property>
                                    </structure>
                                </list-property>
                                <column id="778">
                                    <property name="width">55%</property>
                                </column>
                                <column id="1519"/>
                                <row id="7352">
                                    <cell id="7260">
                                        <property name="style">becpg-meta-cell-label</property>
                                        <property name="textAlign">right</property>
                                         <label id="3406">
                                             <text-property name="text" key="becpg.report.pif.header.created">Created :</text-property>
                                         </label>
                                     </cell>
                                     <cell id="7261">
                                         <property name="style">becpg-meta-cell-data</property>
                                         <property name="textAlign">right</property>
                                         <data id="3407">
                                             <structure name="dateTimeFormat">
                                                 <property name="category">Medium Date</property>
                                                 <property name="pattern">Medium Date</property>
                                             </structure>
                                             <property name="dataSet">Product</property>
                                             <list-property name="boundDataColumns">
                                                 <structure>
                                                     <property name="name">created</property>
                                                     <text-property name="displayName">created</text-property>
                                                     <expression name="expression" type="javascript">dataSetRow["created"]</expression>
                                                     <property name="dataType">date-time</property>
                                                 </structure>
                                             </list-property>
                                             <property name="resultSetColumn">created</property>
                                         </data>
                                     </cell>
                                 </row>
                                 <row id="779">
                                     <cell id="780">
                                         <property name="style">becpg-meta-cell-label</property>
                                         <property name="textAlign">right</property>
                                         <label id="1520">
                                             <text-property name="text" key="becpg.report.pif.header.modified">Modified :</text-property>
                                         </label>
                                     </cell>
                                     <cell id="1516">
                                         <property name="style">becpg-meta-cell-data</property>
                                         <property name="textAlign">right</property>
                                         <data id="1522">
                                             <structure name="dateTimeFormat">
                                                 <property name="category">Medium Date</property>
                                                 <property name="pattern">Medium Date</property>
                                             </structure>
                                             <property name="whiteSpace">nowrap</property>
                                             <property name="dataSet">Product</property>
                                             <list-property name="boundDataColumns">
                                                 <structure>
                                                     <property name="name">modified</property>
