                                         <property name="style">becpg-cell-header</property>
                                         <label id="923">
                                             <text-property name="text" key="becpg.report.pif.label.tobelabeled">To be labeled</text-property>
                                         </label>
                                     </cell>
                                 </row>
                             </header>
                             <detail>
                                 <row id="924">
                                     <cell id="925">
                                         <property name="style">becpg-cell-dynamic-header-left</property>
                                         <data id="926">
                                             <property name="resultSetColumn">allergenListAllergen</property>
                                         </data>
                                     </cell>
                                     <cell id="927">
                                         <property name="style">becpg-cell-data-center</property>
                                         <data id="928">
                                             <property name="resultSetColumn">qtyPercText</property>
                                         </data>
                                     </cell>
                                     <cell id="929">
                                         <property name="style">becpg-cell-data-center</property>
                                         <data id="930">
                                             <property name="resultSetColumn">thresholdText</property>
                                         </data>
                                     </cell>
                                     <cell id="931">
                                         <property name="style">becpg-cell-data-center</property>
                                         <data id="932">
                                             <property name="resultSetColumn">toBeLabeled</property>
                                         </data>
                                     </cell>
                                 </row>
                             </detail>
                         </table>

                         <grid id="700">
                             <property name="width">100%</property>
                             <property name="marginTop">10pt</property>
                             <column id="701"/>
                             <row id="702">
                                 <property name="style">becpg-chapter-header</property>
                                 <cell id="703">
                                     <property name="style">becpg-chapter-header</property>
                                     <label id="704">
                                         <property name="style">becpg-chapter-header</property>
                                         <text-property name="text" key="becpg.report.pif.table.claims">CLAIMED EFFECTS</text-property>
                                     </label>
                                 </cell>
                             </row>
                         </grid>

                         <table id="710">
                             <property name="width">100%</property>
                             <property name="marginTop">6pt</property>
                             <property name="dataSet">pifClaims</property>
                             <list-property name="boundDataColumns">
                                 <structure>
                                     <property name="name">lclLabelClaim</property>
                                     <expression name="expression" type="javascript">dataSetRow["lclLabelClaim"]</expression>
                                     <property name="dataType">string</property>
                                 </structure>
                                 <structure>
                                     <property name="name">lclClaimValue</property>
                                     <expression name="expression" type="javascript">dataSetRow["lclClaimValue"]</expression>
                                     <property name="dataType">string</property>
                                 </structure>
                                 <structure>
                                     <property name="name">claimValueText</property>
                                     <expression name="expression" type="javascript">dataSetRow["claimValueText"]</expression>
                                     <property name="dataType">string</property>
                                 </structure>
                                 <structure>
                                     <property name="name">percentClaimText</property>
                                     <expression name="expression" type="javascript">dataSetRow["percentClaimText"]</expression>
                                     <property name="dataType">string</property>
                                 </structure>
                             </list-property>
                             <list-property name="filter">
                                 <structure>
                                     <property name="operator">is-true</property>
                                     <expression name="expr" type="javascript">row["lclClaimValue"] == "true" || row["lclClaimValue"] == "certified" || row["lclClaimValue"] == "suitable"</expression>
                                 </structure>
                             </list-property>
                             <column id="711">
                                 <property name="width">60%</property>
                             </column>
                             <column id="712">
                                 <property name="width">20%</property>
                             </column>
                             <column id="713">
                                 <property name="width">20%</property>
                             </column>
                             <header>
                                 <row id="714">
                                     <cell id="715">
                                         <property name="style">becpg-cell-header</property>
                                         <label id="716">
                                             <text-property name="text" key="becpg.report.pif.label.claim">Claim</text-property>
                                         </label>
                                     </cell>
                                     <cell id="717">
                                         <property name="style">becpg-cell-header</property>
                                         <label id="718">
                                             <text-property name="text" key="becpg.report.pif.label.claimvalue">Status</text-property>
                                         </label>
                                     </cell>
                                     <cell id="719">
                                         <property name="style">becpg-cell-header</property>
                                         <label id="720">
                                             <text-property name="text" key="becpg.report.pif.label.percentclaim">Claimed %</text-property>
                                         </label>
                                     </cell>
                                 </row>
                             </header>
                             <detail>
                                 <row id="721">
                                     <cell id="722">
                                         <property name="style">becpg-cell-dynamic-header-left</property>
                                         <data id="723">
                                             <property name="resultSetColumn">lclLabelClaim</property>
                                         </data>
                                     </cell>
                                     <cell id="724">
                                         <property name="style">becpg-cell-data-center</property>
                                         <data id="725">
                                             <property name="resultSetColumn">claimValueText</property>
                                         </data>
                                     </cell>
                                     <cell id="726">
                                         <property name="style">becpg-cell-data-center</property>
                                         <data id="727">
                                             <property name="resultSetColumn">percentClaimText</property>
                                         </data>
                                     </cell>
                                 </row>
                             </detail>
                         </table>

                         <!-- Section 6: SAFETY -->
                         <grid id="950">
                             <property name="width">100%</property>
                             <property name="marginTop">10pt</property>
                             <column id="951"/>
                             <row id="952">
                                 <cell id="953">
                                     <label id="954">
                                         <property name="style">UnderlinedSubTitle</property>
                                         <text-property name="text" key="becpg.report.pif.section.safety">6. SAFETY</text-property>
                                     </label>
                                 </cell>
                             </row>
                         </grid>

                         <grid id="955">
                             <property name="width">100%</property>
                             <property name="marginTop">10pt</property>
                             <column id="956"/>
                             <row id="957">
                                 <property name="style">becpg-chapter-header</property>
                                 <cell id="958">
                                     <property name="style">becpg-chapter-header</property>
                                     <label id="959">
                                         <property name="style">becpg-chapter-header</property>
                                         <text-property name="text" key="becpg.report.pif.table.exposure">EXPOSURE SCENARIOS</text-property>
                                     </label>
                                 </cell>
                             </row>
                         </grid>

                         <table id="960">
                             <property name="width">100%</property>
                             <property name="marginTop">6pt</property>
                             <property name="dataSet">pifToxicology</property>
                             <list-property name="boundDataColumns">
                                 <structure>
                                     <property name="name">toxListTox</property>
                                     <expression name="expression" type="javascript">dataSetRow["toxListTox"]</expression>
                                     <property name="dataType">string</property>
                                 </structure>
                                 <structure>
                                     <property name="name">maxConcentrationText</property>
                                     <expression name="expression" type="javascript">dataSetRow["maxConcentrationText"]</expression>
                                     <property name="dataType">string</property>
                                 </structure>
                                 <structure>
                                     <property name="name">withinLimits</property>
                                     <expression name="expression" type="javascript">dataSetRow["toxListValue"] == null ? "" : reportContext.getMessage(dataSetRow["toxListValue"] &gt;= 100 ? "yes" : "no", reportContext.getLocale())</expression>
                                     <property name="dataType">string</property>
                                 </structure>
                             </list-property>
                             <column id="961">
                                 <property name="width">50%</property>
                             </column>
                             <column id="962">
                                 <property name="width">30%</property>
                             </column>
                             <column id="963">
                                 <property name="width">20%</property>
                             </column>
                             <header>
                                 <row id="964">
                                     <cell id="965">
                                         <property name="style">becpg-cell-header</property>
                                         <label id="966">
                                             <text-property name="text" key="becpg.report.pif.label.exposurescenario">Exposure scenario</text-property>
                                         </label>
                                     </cell>
                                     <cell id="967">
                                         <property name="style">becpg-cell-header</property>
                                         <label id="968">
                                             <text-property name="text" key="becpg.report.pif.label.maxconcentration">Max. product concentration (%)</text-property>
                                         </label>
                                     </cell>
                                     <cell id="969">
                                         <property name="style">becpg-cell-header</property>
                                         <label id="970">
                                             <text-property name="text" key="becpg.report.pif.label.withinlimits">Within limits</text-property>
                                         </label>
                                     </cell>
                                 </row>
                             </header>
                             <detail>
                                 <row id="971">
                                     <cell id="972">
                                         <property name="style">becpg-cell-dynamic-header-left</property>
                                         <data id="973">
                                             <property name="resultSetColumn">toxListTox</property>
                                         </data>
                                     </cell>
                                     <cell id="974">
                                         <property name="style">becpg-cell-data-center</property>
                                         <data id="975">
                                             <property name="resultSetColumn">maxConcentrationText</property>
                                         </data>
                                     </cell>
                                     <cell id="976">
                                         <property name="style">becpg-cell-data-center</property>
                                         <data id="977">
                                             <property name="resultSetColumn">withinLimits</property>
                                         </data>
                                     </cell>
                                 </row>
                             </detail>
                         </table>

                    </cell>
                </row>
            </detail>
        </table>

    </body>
</report>
