<?xml version="1.0" encoding="UTF-8"?>
<report xmlns="http://www.eclipse.org/birt/2005/design" version="3.2.23" id="1">
    <property name="author">beCPG</property>
    <property name="createdBy">Eclipse BIRT Designer Version 4.8.0.v201806261756</property>
    <simple-property-list name="includeResource">
        <value>./ProductReport</value>
    </simple-property-list>
    <property name="units">in</property>
    <list-property name="cssStyleSheets">
        <structure>
            <property name="fileName">becpg-report.css</property>
            <property name="useExternalCss">true</property>
        </structure>
    </list-property>
    <data-sources>
        <oda-data-source extensionID="org.eclipse.datatools.enablement.oda.xml" name="DataXml" id="452">
            <property name="FILELIST">beCPG/birt/document/product/default/ProductReport.xml</property>
        </oda-data-source>
    </data-sources>
    <data-sets>
        <oda-data-set extensionID="org.eclipse.datatools.enablement.oda.xml.dataSet" name="Product" id="453">
            <property name="nullsOrdering">nulls lowest</property>
            <property name="dataSource">DataXml</property>
            <xml-property name="queryText"><![CDATA[table0#-TNAME-#table0#:#[/entity]#:#{code;STRING;/code},{name;STRING;/name},{title;STRING;/title},{legalName;STRING;/legalName},{versionLabel;STRING;/versionLabel},{productState;STRING;/productState},{modified;TIMESTAMP;/modified}]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.datatools.enablement.oda.xml.dataSet" name="compoListDirect" id="9991">
            <property name="nullsOrdering">nulls lowest</property>
            <property name="dataSource">DataXml</property>
            <xml-property name="queryText"><![CDATA[table0#-TNAME-#table0#:#[/entity/dataLists/compoLists/compoList]#:#{compoListProduct;STRING;/@compoListProduct},{compoListQty;DOUBLE;/@compoListQty},{compoListUnit;STRING;/@compoListUnit},{itemType;STRING;/@itemType},{erpCode;STRING;/@erpCode}]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.datatools.enablement.oda.xml.dataSet" name="ingListDirect" id="9992">
            <property name="nullsOrdering">nulls lowest</property>
            <property name="dataSource">DataXml</property>
            <xml-property name="queryText"><![CDATA[table0#-TNAME-#table0#:#[/entity/dataLists/ingLists/ingList]#:#{ingListIng;STRING;/@ingListIng},{ingListQtyPerc;DOUBLE;/@ingListQtyPerc},{ingListFunctionality;STRING;/@ingListFunctionality},{ingListIsGMO;STRING;/@ingListIsGMO},{ingListIsIonized;STRING;/@ingListIsIonized},{ingListGeoOrigin;STRING;/@ingListGeoOrigin},{ingListGeoTransfo;STRING;/@ingListGeoTransfo},{ingListBioOrigin;STRING;/@ingListBioOrigin},{ingListClaims;STRING;/@ingListClaims}]]></xml-property>
        </oda-data-set>
    </data-sets>
    <styles>
        <style name="report" id="2">
            <property name="fontFamily">"arial"</property>
            <property name="fontSize">10pt</property>
        </style>
        <style name="becpg-chapter-header" id="4">
            <property name="backgroundColor">#004254</property>
            <property name="fontFamily">sans-serif</property>
            <property name="fontSize">10pt</property>
            <property name="fontWeight">bold</property>
            <property name="color">#FFFFFF</property>
            <property name="textAlign">center</property>
            <property name="paddingTop">5pt</property>
            <property name="paddingBottom">5pt</property>
        </style>
        <style name="UnderlinedSubTitle" id="6">
            <property name="fontFamily">"arial"</property>
            <property name="fontSize">9pt</property>
            <property name="fontWeight">bold</property>
            <property name="color">#004254</property>
            <property name="textUnderline">underline</property>
            <property name="paddingTop">6pt</property>
            <property name="paddingBottom">4pt</property>
        </style>
    </styles>
    <page-setup>
        <simple-master-page name="Simple MasterPage" id="10">
            <property name="type">a4</property>
            <property name="orientation">portrait</property>
            <property name="topMargin">1cm</property>
            <property name="leftMargin">1.5cm</property>
            <property name="bottomMargin">0.4cm</property>
            <property name="rightMargin">1.5cm</property>
        </simple-master-page>
    </page-setup>
    <body>
        <!-- Chapter Header Banner -->
        <grid id="12250">
            <property name="width">100%</property>
            <column id="12251"/>
            <row id="12252">
                <cell id="12253">
                    <property name="style">becpg-chapter-header</property>
                    <label id="12254">
                        <property name="style">becpg-chapter-header</property>
                        <text-property name="text">COMPOSITION QUALITATIVE ET QUANTITATIVE</text-property>
                    </label>
                </cell>
            </row>
        </grid>

        <!-- Sub-section 1: Formula Composition -->
        <grid id="12260">
            <property name="width">100%</property>
            <property name="marginTop">10pt</property>
            <column id="12261"/>
            <row id="12262">
                <cell id="12263">
                    <property name="style">becpg-chapter-header</property>
                    <label id="12264">
                        <property name="style">becpg-chapter-header</property>
                        <text-property name="text">COMPOSITION DE LA FORMULE</text-property>
                    </label>
                </cell>
            </row>
        </grid>

        <table id="12270">
            <property name="style">becpg-table</property>
            <property name="borderSpacing">0pt</property>
            <property name="width">100%</property>
            <property name="dataSet">compoListDirect</property>
            <list-property name="boundDataColumns">
                <structure>
                    <property name="name">erpCode</property>
                    <expression name="expression" type="javascript">dataSetRow["erpCode"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">compoListProduct</property>
                    <expression name="expression" type="javascript">dataSetRow["compoListProduct"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">compoListQty</property>
                    <expression name="expression" type="javascript">dataSetRow["compoListQty"]</expression>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="name">compoListUnit</property>
                    <expression name="expression" type="javascript">dataSetRow["compoListUnit"]</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <column id="12271">
                <property name="width">20%</property>
            </column>
            <column id="12272">
                <property name="width">55%</property>
            </column>
            <column id="12273">
                <property name="width">25%</property>
            </column>
            <header>
                <row id="12274">
                    <cell id="12275">
                        <property name="style">becpg-cell-header</property>
                        <label id="12276">
                            <property name="style">becpg-col-header</property>
                            <text-property name="text">Code MP</text-property>
                        </label>
                    </cell>
                    <cell id="12277">
                        <property name="style">becpg-cell-header</property>
                        <label id="12278">
                            <property name="style">becpg-col-header</property>
                            <text-property name="text">Intitulé MP / Composant</text-property>
                        </label>
                    </cell>
                    <cell id="12279">
                        <property name="style">becpg-cell-header</property>
                        <label id="12280">
                            <property name="style">becpg-col-header</property>
                            <text-property name="text">Quantité / Proportion</text-property>
                        </label>
                    </cell>
                </row>
            </header>
            <detail>
                <row id="12281">
                    <cell id="12282">
                        <data id="12283">
                            <property name="style">becpg-cell-data</property>
                            <property name="resultSetColumn">erpCode</property>
                        </data>
                    </cell>
                    <cell id="12284">
                        <data id="12285">
                            <property name="style">becpg-cell-data-left</property>
                            <property name="resultSetColumn">compoListProduct</property>
                        </data>
                    </cell>
                    <cell id="12286">
                        <data id="12287">
                            <property name="style">becpg-cell-data</property>
                            <property name="resultSetColumn">compoListQty</property>
                        </data>
                    </cell>
                </row>
            </detail>
        </table>

        <!-- Sub-section 2: INCI Ingredient List (Matching Image 1 / Image 3) -->
        <grid id="12290">
            <property name="width">100%</property>
            <property name="marginTop">14pt</property>
            <column id="12291"/>
            <row id="12292">
                <cell id="12293">
                    <property name="style">becpg-chapter-header</property>
                    <label id="12294">
                        <property name="style">becpg-chapter-header</property>
                        <text-property name="text">LISTE D'INGRÉDIENTS</text-property>
                    </label>
                </cell>
            </row>
        </grid>

        <table id="12300">
            <property name="style">becpg-table</property>
            <property name="borderSpacing">0pt</property>
            <property name="width">100%</property>
            <property name="dataSet">ingListDirect</property>
            <list-property name="boundDataColumns">
                <structure>
                    <property name="name">ingListIng</property>
                    <expression name="expression" type="javascript">dataSetRow["ingListIng"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">ingListQtyPerc</property>
                    <expression name="expression" type="javascript">dataSetRow["ingListQtyPerc"]</expression>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="name">ingListIsGMO</property>
                    <expression name="expression" type="javascript">dataSetRow["ingListIsGMO"] != null ? dataSetRow["ingListIsGMO"] : "Non"</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">ingListIsIonized</property>
                    <expression name="expression" type="javascript">dataSetRow["ingListIsIonized"] != null ? dataSetRow["ingListIsIonized"] : "Non"</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">auxTech</property>
                    <expression name="expression" type="javascript">"Non"</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">support</property>
                    <expression name="expression" type="javascript">"Non"</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">ingListGeoOrigin</property>
                    <expression name="expression" type="javascript">dataSetRow["ingListGeoOrigin"] != null ? dataSetRow["ingListGeoOrigin"] : ""</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">ingListGeoTransfo</property>
                    <expression name="expression" type="javascript">dataSetRow["ingListGeoTransfo"] != null ? dataSetRow["ingListGeoTransfo"] : ""</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">ingListBioOrigin</property>
                    <expression name="expression" type="javascript">dataSetRow["ingListBioOrigin"] != null ? dataSetRow["ingListBioOrigin"] : ""</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">ingListClaims</property>
                    <expression name="expression" type="javascript">dataSetRow["ingListClaims"] != null ? dataSetRow["ingListClaims"] : ""</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <column id="12301">
                <property name="width">18%</property>
            </column>
            <column id="12302">
                <property name="width">10%</property>
            </column>
            <column id="12303">
                <property name="width">8%</property>
            </column>
            <column id="12304">
                <property name="width">8%</property>
            </column>
            <column id="12305">
                <property name="width">10%</property>
            </column>
            <column id="12306">
                <property name="width">8%</property>
            </column>
            <column id="12307">
                <property name="width">10%</property>
            </column>
