                <property name="width">10%</property>
            </column>
            <column id="12309">
                <property name="width">9%</property>
            </column>
            <column id="12310">
                <property name="width">9%</property>
            </column>
            <header>
                <row id="12311">
                    <cell id="12312">
                        <property name="style">becpg-cell-header</property>
