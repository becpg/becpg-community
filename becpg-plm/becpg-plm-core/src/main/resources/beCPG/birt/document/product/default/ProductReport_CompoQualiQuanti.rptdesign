                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="name">ingListIsGMO</property>
                    <expression name="expression" type="javascript">reportContext.getMessage(dataSetRow["ingListIsGMO"], reportContext.getLocale()) != null ? reportContext.getMessage(dataSetRow["ingListIsGMO"], reportContext.getLocale()) : "Non"</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">ingListIsIonized</property>
                    <expression name="expression" type="javascript">reportContext.getMessage(dataSetRow["ingListIsIonized"], reportContext.getLocale()) != null ? reportContext.getMessage(dataSetRow["ingListIsIonized"], reportContext.getLocale()) : "Non"</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">auxTech</property>
