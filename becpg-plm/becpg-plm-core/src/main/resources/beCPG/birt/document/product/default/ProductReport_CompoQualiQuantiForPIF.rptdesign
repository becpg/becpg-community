    <simple-property-list name="includeResource">
        <value>./ProductReport</value>
    </simple-property-list>
    <property name="units">in</property>
    <list-property name="cssStyleSheets">
        <structure>
            <property name="fileName">becpg-report.css</property>
            <property name="useExternalCss">true</property>
        </structure>
    </list-property>
    <data-sources>
        <oda-data-source extensionID="org.eclipse.datatools.enablement.oda.xml" name="DataXml" id="452">
            <property name="FILELIST">beCPG/birt/document/product/default/ProductReport.xml</property>
        </oda-data-source>
    </data-sources>
    <data-sets>
        <oda-data-set extensionID="org.eclipse.datatools.enablement.oda.xml.dataSet" name="Product" id="453">
            <property name="nullsOrdering">nulls lowest</property>
            <list-property name="computedColumns">
                <structure>
                    <property name="name">versionLabelToShow</property>
                    <expression name="expression">if(row["versionLabelBcpg"] != null){
	row["versionLabelBcpg"]
} else if(row["versionLabel"] != null){
	row["versionLabel"]
} else "1.0"</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="dataSource">DataXml</property>
            <xml-property name="queryText"><![CDATA[table0#-TNAME-#table0#:#[/entity]#:#{code;STRING;/code},{name;STRING;/name},{title;STRING;/title},{legalName;STRING;/legalName},{versionLabel;STRING;/versionLabel},{versionLabelBcpg;STRING;/versionLabel[@prefix='bcpg']},{productState;STRING;/productState},{modified;TIMESTAMP;/modified},{created;TIMESTAMP;/created},{erpCode;STRING;/erpCode}]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.datatools.enablement.oda.xml.dataSet" name="imgLogo" id="12186">
            <property name="nullsOrdering">nulls lowest</property>
            <property name="dataSource">DataXml</property>
            <xml-property name="queryText"><![CDATA[table0#-TNAME-#table0#:#[/entity/images/image]#:#{id;STRING;/@id},{entityName;STRING;/@entityName},{name;STRING;/@name},{entityType;STRING;/@entityType}]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.datatools.enablement.oda.xml.dataSet" name="compoListDirect" id="9991">
            <property name="nullsOrdering">nulls lowest</property>
            <property name="dataSource">DataXml</property>
            <xml-property name="queryText"><![CDATA[table0#-TNAME-#table0#:#[/entity/dataLists/compoLists/compoList]#:#{compoListProduct;STRING;/@compoListProduct},{compoListQty;DOUBLE;/@compoListQty},{compoListUnit;STRING;/@compoListUnit},{itemType;STRING;/@itemType},{erpCode;STRING;/@erpCode},{depthLevel;STRING;/@depthLevel}]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.datatools.enablement.oda.xml.dataSet" name="ingListDirect" id="9992">
            <property name="nullsOrdering">nulls lowest</property>
            <property name="dataSource">DataXml</property>
            <xml-property name="queryText"><![CDATA[table0#-TNAME-#table0#:#[/entity/dataLists/ingLists/ingList]#:#{ingListIng;STRING;/@ingListIng},{ingListQtyPerc;DOUBLE;/@ingListQtyPerc},{ingListFunctionality;STRING;/@ingListFunctionality},{casNumber;STRING;/@casNumber},{ceNumber;STRING;/@ceNumber},{ecNumber;STRING;/@ecNumber},{ingListIsGMO;STRING;/@ingListIsGMO},{ingListIsIonized;STRING;/@ingListIsIonized},{ingListGeoOrigin;STRING;/@ingListGeoOrigin},{ingListGeoTransfo;STRING;/@ingListGeoTransfo},{ingListBioOrigin;STRING;/@ingListBioOrigin},{ingListClaims;STRING;/@ingListClaims}]]></xml-property>
        </oda-data-set>
    </data-sets>
