    <body>
        <!-- Table 1: Formula Composition -->
        <table id="12270">
            <property name="width">100%</property>
            <property name="dataSet">compoListDirect</property>
            <list-property name="boundDataColumns">
                <structure>
                    <property name="name">depthLevel</property>
                    <expression name="expression" type="javascript">dataSetRow["depthLevel"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">erpCode</property>
                    <expression name="expression" type="javascript">dataSetRow["erpCode"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">compoListProduct</property>
                    <expression name="expression" type="javascript">dataSetRow["compoListProduct"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">compoListQty</property>
                    <expression name="expression" type="javascript">dataSetRow["compoListQty"]</expression>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="name">compoListQtyTotal</property>
                    <property name="dataType">float</property>
                    <property name="aggregateFunction">SUM</property>
                    <list-property name="arguments">
                        <structure>
                            <property name="name">Expression</property>
                            <expression name="value" type="javascript">row["compoListQty"]</expression>
                        </structure>
                    </list-property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">compoListPerc</property>
                    <expression name="expression" type="javascript">row["compoListQty"] != null &amp;&amp; row["compoListQtyTotal"] > 0 ? String(Math.round(row["compoListQty"] / row["compoListQtyTotal"] * 100000) / 1000) : ""</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">compoListUnit</property>
                    <expression name="expression" type="javascript">dataSetRow["compoListUnit"]</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <list-property name="filter">
                <structure>
                    <property name="operator">is-true</property>
                    <expression name="expr" type="javascript">row["depthLevel"] == null || row["depthLevel"] == "" || row["depthLevel"] == "1"</expression>
                </structure>
            </list-property>
            <column id="12271">
                <property name="width">20%</property>
            </column>
            <column id="12272">
                <property name="width">55%</property>
            </column>
            <column id="12273">
                <property name="width">25%</property>
            </column>
            <header>
                <row id="12252">
                    <property name="style">becpg-chapter-header</property>
                    <cell id="12253">
                        <property name="colSpan">3</property>
                        <property name="style">becpg-chapter-header</property>
                        <label id="12254">
                            <property name="style">becpg-chapter-header</property>
                            <text-property name="text" key="formulaComposition">COMPOSITION DE LA FORMULE</text-property>
                        </label>
                    </cell>
                </row>
                <row id="13000">
                    <property name="height">8pt</property>
                    <cell id="13001">
                        <property name="colSpan">3</property>
                    </cell>
                </row>
                <row id="12274">
                    <cell id="12275">
                        <property name="style">becpg-cell-header</property>
                        <label id="12276">
                            <text-property name="text" key="rawMaterialCode">Code MP</text-property>
                        </label>
                    </cell>
                    <cell id="12277">
                        <property name="style">becpg-cell-header</property>
                        <label id="12278">
                            <text-property name="text" key="rawMaterialName">Intitulé MP / Composant</text-property>
                        </label>
                    </cell>
                    <cell id="12279">
                        <property name="style">becpg-cell-header</property>
                        <label id="12280">
                            <text-property name="text" key="quantityPercentage">Quantité (%)</text-property>
                        </label>
                    </cell>
                </row>
            </header>
            <detail>
                <row id="12281">
                    <cell id="12282">
                        <property name="style">becpg-cell-data</property>
                        <data id="12283">
                            <property name="resultSetColumn">erpCode</property>
                        </data>
                    </cell>
                    <cell id="12284">
                        <property name="style">becpg-cell-data-left</property>
                        <data id="12285">
                            <property name="resultSetColumn">compoListProduct</property>
                        </data>
                    </cell>
                    <cell id="12286">
                        <property name="style">becpg-cell-data</property>
                        <data id="12287">
                            <property name="resultSetColumn">compoListPerc</property>
                        </data>
                    </cell>
                </row>
            </detail>
        </table>

        <label id="12289">
            <text-property name="text"> </text-property>
        </label>

        <!-- Table 2: INCI Ingredient List (Matching Image 1 / Image 3) -->
        <table id="12300">
            <property name="marginTop">12pt</property>
            <property name="width">100%</property>
            <property name="dataSet">ingListDirect</property>
            <list-property name="boundDataColumns">
                <structure>
                    <property name="name">ingListIng</property>
                    <expression name="expression" type="javascript">dataSetRow["ingListIng"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">ingListFunctionality</property>
                    <expression name="expression" type="javascript">dataSetRow["ingListFunctionality"] != null ? dataSetRow["ingListFunctionality"] : ""</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">casNumber</property>
                    <expression name="expression" type="javascript">dataSetRow["casNumber"] != null ? dataSetRow["casNumber"] : ""</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">ecOrEinecsNumber</property>
                    <expression name="expression" type="javascript">(dataSetRow["ceNumber"] != null &amp;&amp; dataSetRow["ceNumber"] != "" ? dataSetRow["ceNumber"] : (dataSetRow["ecNumber"] != null ? dataSetRow["ecNumber"] : "")).replace(/\s*,\s*/g, ", ")</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">ingListQtyPerc</property>
                    <expression name="expression" type="javascript">dataSetRow["ingListQtyPerc"] != null ? String(Math.round(dataSetRow["ingListQtyPerc"] * 1000000) / 1000000) : ""</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
