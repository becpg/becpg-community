                                    </structure>
                                    <structure>
                                        <property name="name">img</property>
                                        <text-property name="displayName">img</text-property>
                                        <expression name="expression" type="javascript">reportContext.getAppContext().get(dataSetRow["id"]);</expression>
                                        <property name="dataType">blob</property>
                                        <property name="allowExport">true</property>
                                    </structure>
                                    <structure>
                                        <property name="name">imgTradeMark</property>
                                        <expression name="expression" type="javascript">reportContext.getAppContext().get(dataSetRow["id"]);</expression>
                                        <property name="dataType">blob</property>
                                        <property name="allowExport">true</property>
                                    </structure>
                                    <structure>
                                        <property name="name">imgLogo</property>
                                        <expression name="expression" type="javascript">reportContext.getAppContext().get("logo.png");</expression>
                                        <property name="dataType">blob</property>
                                        <property name="allowExport">true</property>
                                    </structure>
                                </list-property>
                                <property name="source">embed</property>
                                <property name="imageName">logo.png</property>
                            </image>
                            <image name="customLogo" id="12231">
                                <property name="height">0.8in</property>
                                <property name="dataSet">imgLogo</property>
                                <list-property name="visibility">
                                    <structure>
                                        <property name="format">all</property>
                                        <expression name="valueExpr" type="javascript">row["imgTradeMark"]!=null || row["img"]==null</expression>
                                    </structure>
                                </list-property>
                                <list-property name="boundDataColumns">
                                    <structure>
                                        <property name="name">id</property>
                                        <expression name="expression" type="javascript">dataSetRow["id"]</expression>
                                        <property name="dataType">string</property>
                                    </structure>
                                    <structure>
                                        <property name="name">entityName</property>
