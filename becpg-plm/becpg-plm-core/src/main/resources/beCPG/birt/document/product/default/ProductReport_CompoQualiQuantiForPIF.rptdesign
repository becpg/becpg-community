                                <property name="style">becpg-header-type</property>
                                <text-property name="text" key="compoQualiQuantiTitle">COMPOSITION QUALITATIVE ET QUANTITATIVE</text-property>
                            </label>
                            <data id="3333">
                                <property name="style">becpg-header-title</property>
