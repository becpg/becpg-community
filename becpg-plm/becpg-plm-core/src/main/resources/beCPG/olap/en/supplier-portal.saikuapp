{
 "id": "supplier-portal",
 "name": "Supplier portal",
 "version": 1,
 "theme": {
  "mode": "light",
  "ground": "#f4f7f8",
  "surface": "#ffffff",
  "fg": "#0d2b33",
  "muted": "#5b7780",
  "accent": "#009dcc"
 },
 "nav": {
  "position": "rail",
  "railFullHeight": true,
  "footer": {
   "settings": true
  }
 },
 "header": {
  "wordmarkAccent": "fournisseur",
  "eyebrow": "beCPG",
  "liveBadge": "Live"
 },
 "assistantSlot": {
  "enabled": true,
  "title": "Supplier assistant",
  "persona": "beCPG supplier and compliance analyst",
  "scope": "Answer only about the cubes products, projectsSteps et requirements.",
  "greeting": "Ask about suppliers, their tasks or compliance.",
  "suggestedPrompts": [
   "Top 10 suppliers",
   "Planned versus actual duration of portal tasks",
   "Unmet requirements"
  ],
  "cube": {
   "connectionName": "beCPG",
   "catalog": "beCPG OLAP Schema",
   "schema": "beCPG OLAP Schema",
   "cubeName": "products"
  }
 },
 "tags": [
  "beCPG",
  "fournisseur"
 ],
 "pages": [
  {
   "id": "fournisseurs",
   "title": "Suppliers",
   "icon": "users",
   "heading": "Supplier panel",
   "subheading": "Supplier weight in the master data",
   "grid": {
    "cols": 12,
    "tiles": [
     {
      "id": "t1",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 6,
      "type": "chart",
      "title": "Top 10 suppliers",
      "query": {
       "kind": "reference",
       "path": "/top-10-suppliers.saiku"
      },
      "chartType": "bar"
     },
     {
      "id": "t2",
      "x": 0,
      "y": 6,
      "w": 12,
      "h": 5,
      "type": "chart",
      "title": "Most expensive raw materials",
      "query": {
       "kind": "reference",
       "path": "/top-10-most-expensive-raw-materials-in-products.saiku"
      },
      "chartType": "bar"
     }
    ]
   }
  },
  {
   "id": "taches",
   "title": "Tasks",
   "icon": "clipboard",
   "heading": "Portal tasks",
   "subheading": "Planned and actual durations",
   "grid": {
    "cols": 12,
    "tiles": [
     {
      "id": "t1",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 6,
      "type": "table",
      "title": "Planned versus actual duration",
      "query": {
       "kind": "reference",
       "path": "/supplier-portal-tasks-planned-vs-actual.saiku"
      }
     }
    ]
   }
  },
  {
   "id": "conformite",
   "title": "Compliance",
   "icon": "shield",
   "heading": "Compliance",
   "subheading": "Unmet requirements and allergens",
   "grid": {
    "cols": 12,
    "tiles": [
     {
      "id": "t1",
      "x": 0,
      "y": 0,
      "w": 7,
      "h": 6,
      "type": "chart",
      "title": "Unmet requirements",
      "query": {
       "kind": "reference",
       "path": "/compliance-unmet-requirements.saiku"
      },
      "chartType": "bar"
     },
     {
      "id": "t2",
      "x": 7,
      "y": 0,
      "w": 5,
      "h": 6,
      "type": "chart",
      "title": "Top 10 allergens",
      "query": {
       "kind": "reference",
       "path": "/top-10-allergens.saiku"
      },
      "chartType": "bar"
     }
    ]
   }
  },
  {
   "id": "certifications",
   "title": "Certifications",
   "icon": "award",
   "heading": "Site certifications",
   "subheading": "Certifications by body and by plant",
   "grid": {
    "cols": 12,
    "tiles": [
     {
      "id": "t6",
      "x": 0,
      "y": 0,
      "w": 6,
      "h": 5,
      "type": "table",
      "title": "By body",
      "query": {
       "kind": "reference",
       "path": "/certifications-by-body.saiku"
      }
     },
     {
      "id": "t7",
      "x": 6,
      "y": 0,
      "w": 6,
      "h": 5,
      "type": "table",
      "title": "By plant",
      "query": {
       "kind": "reference",
       "path": "/certifications-by-plant.saiku"
      }
     }
    ]
   }
  }
 ]
}
