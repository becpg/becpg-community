{
 "id": "referentiel-produit",
 "name": "Product master data",
 "version": 1,
 "theme": {
  "mode": "light",
  "ground": "#f4f7f8",
  "surface": "#ffffff",
  "fg": "#0d2b33",
  "muted": "#5b7780",
  "accent": "#009dcc"
 },
 "nav": {
  "position": "rail",
  "railFullHeight": true,
  "footer": {
   "settings": true
  }
 },
 "header": {
  "wordmarkAccent": "produit",
  "eyebrow": "beCPG",
  "liveBadge": "Live"
 },
 "assistantSlot": {
  "enabled": true,
  "title": "Product assistant",
  "persona": "beCPG product master-data analyst",
  "scope": "Answer only about the cubes products, nutrients et lca.",
  "greeting": "Ask about the product portfolio, nutrition or costs.",
  "suggestedPrompts": [
   "Breakdown of products per state",
   "Average profitability per family",
   "Products per Nutri-Score"
  ],
  "cube": {
   "connectionName": "beCPG",
   "catalog": "beCPG OLAP Schema",
   "schema": "beCPG OLAP Schema",
   "cubeName": "products"
  }
 },
 "tags": [
  "beCPG",
  "produit"
 ],
 "pages": [
  {
   "id": "portefeuille",
   "title": "Portfolio",
   "icon": "package",
   "heading": "Product portfolio",
   "subheading": "Volumes, prices, costs and profitability per family",
   "grid": {
    "cols": 12,
    "tiles": [
     {
      "id": "t1",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 5,
      "type": "table",
      "title": "Volumes, prices, costs and profitability",
      "query": {
       "kind": "reference",
       "path": "/Portfolio - volumes and margins.saiku"
      }
     },
     {
      "id": "t2",
      "x": 0,
      "y": 5,
      "w": 6,
      "h": 5,
      "type": "chart",
      "title": "Profit per family",
      "query": {
       "kind": "reference",
       "path": "/Portfolio - profit per family.saiku"
      },
      "chartType": "bar"
     },
     {
      "id": "t3",
      "x": 6,
      "y": 5,
      "w": 6,
      "h": 5,
      "type": "chart",
      "title": "Breakdown per state",
      "query": {
       "kind": "reference",
       "path": "/Products per state.saiku"
      },
      "chartType": "pie"
     }
    ]
   }
  },
  {
   "id": "qualite",
   "title": "Quality",
   "icon": "leaf",
   "heading": "Quality and nutritional profile",
   "subheading": "Nutri-Score, Eco-Score and formulated nutrients",
   "grid": {
    "cols": 12,
    "tiles": [
     {
      "id": "t1",
      "x": 0,
      "y": 0,
      "w": 6,
      "h": 5,
      "type": "chart",
      "title": "Breakdown per Nutri-Score",
      "query": {
       "kind": "reference",
       "path": "/FP per Nutri-Score.saiku"
      },
      "chartType": "bar"
     },
     {
      "id": "t2",
      "x": 6,
      "y": 0,
      "w": 6,
      "h": 5,
      "type": "chart",
      "title": "Breakdown per Eco-Score",
      "query": {
       "kind": "reference",
       "path": "/FP per Eco-Score.saiku"
      },
      "chartType": "bar"
     },
     {
      "id": "t3",
      "x": 0,
      "y": 5,
      "w": 12,
      "h": 5,
      "type": "table",
      "title": "Formulated nutrients per product type",
      "query": {
       "kind": "reference",
       "path": "/Formulated nutrients per product type.saiku"
      }
     }
    ]
   }
  },
  {
   "id": "logistique",
   "title": "Logistics",
   "icon": "truck",
   "heading": "Conditions and costs",
   "subheading": "Storage, packaging and projected quantities",
   "grid": {
    "cols": 12,
    "tiles": [
     {
      "id": "t1",
      "x": 0,
      "y": 0,
      "w": 6,
      "h": 5,
      "type": "chart",
      "title": "Products per storage condition",
      "query": {
       "kind": "reference",
       "path": "/Products per storage condition.saiku"
      },
      "chartType": "bar"
     },
     {
      "id": "t2",
      "x": 6,
      "y": 0,
      "w": 6,
      "h": 5,
      "type": "chart",
      "title": "Packaging weight by family",
      "query": {
       "kind": "reference",
       "path": "/Packaging materials - weight by product family.saiku"
      },
      "chartType": "bar"
     },
     {
      "id": "t3",
      "x": 0,
      "y": 5,
      "w": 12,
      "h": 4,
      "type": "table",
      "title": "Projected quantities per family",
      "query": {
       "kind": "reference",
       "path": "/FP Projected quantities per family.saiku"
      }
     }
    ]
   }
  },
  {
   "id": "couts",
   "title": "Costs",
   "icon": "coins",
   "heading": "Cost structure and trend",
   "subheading": "Cost per item, year-on-year trend and gap to maximum",
   "grid": {
    "cols": 12,
    "tiles": [
     {
      "id": "t10",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 5,
      "type": "table",
      "title": "Breakdown by item",
      "query": {
       "kind": "reference",
       "path": "/Costs - breakdown by item.saiku"
      }
     },
     {
      "id": "t11",
      "x": 0,
      "y": 5,
      "w": 6,
      "h": 5,
      "type": "chart",
      "title": "Trend by family",
      "query": {
       "kind": "reference",
       "path": "/Costs - trend by family.saiku"
      },
      "chartType": "bar"
     },
     {
      "id": "t12",
      "x": 6,
      "y": 5,
      "w": 6,
      "h": 5,
      "type": "chart",
      "title": "Gap to maximum",
      "query": {
       "kind": "reference",
       "path": "/Costs - gap to maximum by family.saiku"
      },
      "chartType": "bar"
     }
    ]
   }
  },
  {
   "id": "emballage",
   "title": "Packaging",
   "icon": "package",
   "heading": "Packaging and sustainability",
   "subheading": "Quantities by level, materials and recycled content",
   "grid": {
    "cols": 12,
    "tiles": [
     {
      "id": "t13",
      "x": 0,
      "y": 0,
      "w": 6,
      "h": 5,
      "type": "table",
      "title": "Quantities by level",
      "query": {
       "kind": "reference",
       "path": "/Packaging - quantities by level.saiku"
      }
     },
     {
      "id": "t14",
      "x": 6,
      "y": 0,
      "w": 6,
      "h": 5,
      "type": "table",
      "title": "Recycled content by material",
      "query": {
       "kind": "reference",
       "path": "/Packaging materials - recycled content.saiku"
      }
     },
     {
      "id": "t15",
      "x": 0,
      "y": 5,
      "w": 12,
      "h": 5,
      "type": "chart",
      "title": "Packaging weight by family",
      "query": {
       "kind": "reference",
       "path": "/Packaging materials - weight by product family.saiku"
      },
      "chartType": "bar"
     }
    ]
   }
  },
  {
   "id": "composition",
   "title": "Composition",
   "icon": "layers",
   "heading": "Composition and yield",
   "subheading": "Loss, material yield and most used components",
   "grid": {
    "cols": 12,
    "tiles": [
     {
      "id": "t16",
      "x": 0,
      "y": 0,
      "w": 6,
      "h": 5,
      "type": "table",
      "title": "Loss and yield",
      "query": {
       "kind": "reference",
       "path": "/Composition - loss and yield by family.saiku"
      }
     },
     {
      "id": "t17",
      "x": 6,
      "y": 0,
      "w": 6,
      "h": 5,
      "type": "table",
      "title": "Most used components",
      "query": {
       "kind": "reference",
       "path": "/Composition - most used components.saiku"
      }
     },
     {
      "id": "t18",
      "x": 0,
      "y": 5,
      "w": 12,
      "h": 5,
      "type": "chart",
      "title": "Packaging components",
      "query": {
       "kind": "reference",
       "path": "/Packaging - most used components.saiku"
      },
      "chartType": "bar"
     }
    ]
   }
  },
  {
   "id": "scores",
   "title": "Scores",
   "icon": "gauge",
   "heading": "Product scores",
   "subheading": "Nutri-Score, Eco-Score and the beCPG regulatory score framework",
   "grid": {
    "cols": 12,
    "tiles": [
     {
      "id": "t19",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 5,
      "type": "table",
      "title": "Scores by definition",
      "query": {
       "kind": "reference",
       "path": "/Scores - breakdown by definition.saiku"
      }
     },
     {
      "id": "t20",
      "x": 0,
      "y": 5,
      "w": 6,
      "h": 5,
      "type": "chart",
      "title": "Nutri-Score breakdown",
      "query": {
       "kind": "reference",
       "path": "/FP per Nutri-Score.saiku"
      },
      "chartType": "pie"
     },
     {
      "id": "t21",
      "x": 6,
      "y": 5,
      "w": 6,
      "h": 5,
      "type": "chart",
      "title": "Eco-Score breakdown",
      "query": {
       "kind": "reference",
       "path": "/FP per Eco-Score.saiku"
      },
      "chartType": "pie"
     },
     {
      "id": "t22",
      "x": 0,
      "y": 10,
      "w": 12,
      "h": 5,
      "type": "chart",
      "title": "Classes by definition",
      "query": {
       "kind": "reference",
