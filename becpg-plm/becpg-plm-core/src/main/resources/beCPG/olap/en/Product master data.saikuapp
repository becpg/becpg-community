{"id": "referentiel-produit", "name": "Product master data", "version": 1, "theme": {"mode": "light", "ground": "#f4f7f8", "surface": "#ffffff", "fg": "#0d2b33", "muted": "#5b7780", "accent": "#009dcc"}, "nav": {"position": "rail", "railFullHeight": true, "footer": {"settings": true}}, "header": {"wordmarkAccent": "produit", "eyebrow": "beCPG", "liveBadge": "Live"}, "assistantSlot": {"enabled": true, "title": "Product assistant", "persona": "beCPG product master-data analyst", "scope": "Answer only about the cubes products, nutrients et lca.", "greeting": "Ask about the product portfolio, nutrition or costs.", "suggestedPrompts": ["Breakdown of products per state", "Average profitability per family", "Products per Nutri-Score"]}, "tags": ["beCPG", "produit"], "pages": [{"id": "portefeuille", "title": "Portfolio", "icon": "package", "heading": "Product portfolio", "subheading": "Volumes, prices, costs and profitability per family", "grid": {"cols": 12, "tiles": [{"id": "t1", "x": 0, "y": 0, "w": 12, "h": 5, "type": "table", "title": "Volumes, prices, costs and profitability", "query": {"kind": "reference", "path": "/Portfolio - volumes and margins.saiku"}}, {"id": "t2", "x": 0, "y": 5, "w": 6, "h": 5, "type": "chart", "title": "Profit per family", "query": {"kind": "reference", "path": "/Portfolio - profit per family.saiku"}, "chartType": "bar"}, {"id": "t3", "x": 6, "y": 5, "w": 6, "h": 5, "type": "chart", "title": "Breakdown per state", "query": {"kind": "reference", "path": "/Products per state.saiku"}, "chartType": "pie"}]}}, {"id": "qualite", "title": "Quality", "icon": "leaf", "heading": "Quality and nutritional profile", "subheading": "Nutri-Score, Eco-Score and formulated nutrients", "grid": {"cols": 12, "tiles": [{"id": "t1", "x": 0, "y": 0, "w": 6, "h": 5, "type": "chart", "title": "Breakdown per Nutri-Score", "query": {"kind": "reference", "path": "/FP per Nutri-Score.saiku"}, "chartType": "bar"}, {"id": "t2", "x": 6, "y": 0, "w": 6, "h": 5, "type": "chart", "title": "Breakdown per Eco-Score", "query": {"kind": "reference", "path": "/FP per Eco-Score.saiku"}, "chartType": "bar"}, {"id": "t3", "x": 0, "y": 5, "w": 12, "h": 5, "type": "table", "title": "Formulated nutrients per product type", "query": {"kind": "reference", "path": "/Formulated nutrients per product type.saiku"}}]}}, {"id": "logistique", "title": "Logistics", "icon": "truck", "heading": "Conditions and costs", "subheading": "Storage, packaging and projected quantities", "grid": {"cols": 12, "tiles": [{"id": "t1", "x": 0, "y": 0, "w": 6, "h": 5, "type": "chart", "title": "Products per storage condition", "query": {"kind": "reference", "path": "/Products per storage condition.saiku"}, "chartType": "bar"}, {"id": "t2", "x": 6, "y": 0, "w": 6, "h": 5, "type": "chart", "title": "Average packaging cost per family", "query": {"kind": "reference", "path": "/Average packaging cost per family.saiku"}, "chartType": "bar"}, {"id": "t3", "x": 0, "y": 5, "w": 12, "h": 4, "type": "table", "title": "Projected quantities per family", "query": {"kind": "reference", "path": "/FP Projected quantities per family.saiku"}}]}}]}