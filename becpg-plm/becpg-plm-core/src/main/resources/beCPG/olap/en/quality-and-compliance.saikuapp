      "id": "t5",
      "x": 0,
      "y": 5,
      "w": 6,
      "h": 5,
      "type": "chart",
      "title": "Major allergens",
      "query": {
       "kind": "reference",
       "path": "/top-10-allergens.saiku"
      },
      "chartType": "bar"
     },
     {
      "id": "t6",
