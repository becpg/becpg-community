{
 "id": "quality-and-compliance",
 "name": "Quality and compliance",
 "version": 1,
 "theme": {
  "mode": "light",
  "ground": "#f4f7f8",
  "surface": "#ffffff",
  "fg": "#0d2b33",
  "muted": "#5b7780",
  "accent": "#009dcc"
 },
 "nav": {
  "position": "rail",
  "railFullHeight": true,
  "footer": {
   "settings": true
  }
 },
 "header": {
  "wordmarkAccent": "compliance",
  "eyebrow": "beCPG",
  "liveBadge": "Live"
 },
 "assistantSlot": {
  "enabled": true,
  "title": "Compliance assistant",
  "persona": "beCPG compliance and regulatory analyst",
  "scope": "Answer only about the regulatoryScores, toxicology, requirements and plantCertifications cubes.",
  "greeting": "Ask about regulatory scores, toxicology or certifications.",
  "suggestedPrompts": [
   "Regulatory score by class",
   "Certifications by body",
   "Unmet requirements"
  ],
  "cube": {
   "connectionName": "beCPG",
   "catalog": "beCPG OLAP Schema",
   "schema": "beCPG OLAP Schema",
   "cubeName": "regulatoryScores"
  }
 },
 "tags": [
  "conformite",
  "reglementaire",
  "qualite"
 ],
 "pages": [
  {
   "id": "reglementaire",
   "title": "Regulatory",
   "icon": "shield",
   "heading": "Regulatory compliance",
   "subheading": "Regulatory scores, classes and trend by family",
   "grid": {
    "cols": 12,
    "tiles": [
     {
      "id": "t1",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 5,
      "type": "table",
      "title": "Regulatory score by class",
      "query": {
       "kind": "reference",
       "path": "/regulatory-score-by-class.saiku"
      }
     },
     {
      "id": "t2",
      "x": 0,
      "y": 5,
      "w": 6,
      "h": 5,
      "type": "chart",
      "title": "Trend by family",
      "query": {
       "kind": "reference",
       "path": "/regulatory-score-trend-by-family.saiku"
      },
      "chartType": "bar"
     },
     {
      "id": "t3",
      "x": 6,
      "y": 5,
      "w": 6,
      "h": 5,
      "type": "chart",
      "title": "Unmet requirements",
      "query": {
       "kind": "reference",
       "path": "/compliance-unmet-requirements.saiku"
      },
      "chartType": "bar"
     }
    ]
   }
  },
  {
   "id": "toxicologie",
   "title": "Toxicology",
   "icon": "flask",
   "heading": "Toxicological thresholds",
   "subheading": "Values, minima and maxima by toxicological agent",
