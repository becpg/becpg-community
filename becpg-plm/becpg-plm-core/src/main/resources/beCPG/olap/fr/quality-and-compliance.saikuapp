{
 "id": "quality-and-compliance",
 "name": "Qualité et conformité",
 "version": 1,
 "theme": {
  "mode": "light",
  "preset": "becpg"
 },
 "nav": {
  "position": "rail",
  "railFullHeight": true,
  "footer": {
   "settings": true
  }
 },
 "header": {
  "wordmarkAccent": "conformité",
  "eyebrow": "beCPG",
  "liveBadge": "En direct"
 },
 "assistantSlot": {
  "enabled": true,
  "title": "Chef IA",
  "icon": "chef",
  "persona": "Analyste conformité et réglementaire beCPG",
  "scope": "Répond à partir du cube Scores réglementaires.",
  "greeting": "Posez une question sur les scores réglementaires des produits.",
  "suggestedPrompts": [
   "Score réglementaire par classe",
   "Produits scorés par catégorie réglementaire",
   "Score réglementaire moyen par famille de produits"
  ],
  "cube": {
   "connectionName": "beCPG",
   "catalog": "beCPG OLAP Schema",
   "schema": "beCPG OLAP Schema",
   "cubeName": "regulatoryScores"
  }
 },
 "tags": [
  "conformite",
  "reglementaire",
  "qualite"
 ],
 "pages": [
  {
   "id": "reglementaire",
   "title": "Réglementaire",
   "icon": "shield",
   "heading": "Conformité réglementaire",
   "subheading": "Scores réglementaires, classes et évolution par famille",
   "grid": {
    "cols": 12,
    "tiles": [
     {
      "id": "t1",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 5,
      "type": "table",
      "title": "Score réglementaire par classe",
      "query": {
       "kind": "reference",
       "path": "/regulatory-score-by-class.saiku"
      }
     },
     {
      "id": "t2",
      "x": 0,
      "y": 5,
      "w": 6,
      "h": 5,
      "type": "chart",
      "title": "Évolution par famille",
      "query": {
       "kind": "reference",
       "path": "/regulatory-score-trend-by-family.saiku"
      },
      "chartType": "bar"
     },
     {
      "id": "t3",
      "x": 6,
      "y": 5,
      "w": 6,
      "h": 5,
      "type": "chart",
      "title": "Exigences non respectées",
      "query": {
       "kind": "reference",
       "path": "/compliance-unmet-requirements.saiku"
      },
      "chartType": "bar"
     }
    ]
   }
  },
  {
   "id": "toxicologie",
   "title": "Toxicologie",
   "icon": "flask",
   "heading": "Seuils toxicologiques",
   "subheading": "Valeurs, minima et maxima par agent toxicologique",
   "grid": {
    "cols": 12,
    "tiles": [
     {
      "id": "t4",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 5,
      "type": "table",
      "title": "Valeurs par agent",
      "query": {
       "kind": "reference",
       "path": "/toxicology-values-by-agent.saiku"
      }
     },
     {
      "id": "t5",
      "x": 0,
      "y": 5,
      "w": 6,
      "h": 5,
      "type": "chart",
      "title": "Allergènes majeurs",
      "query": {
       "kind": "reference",
       "path": "/top-10-allergens.saiku"
      },
      "chartType": "bar"
     },
     {
      "id": "t6",
      "x": 6,
      "y": 5,
      "w": 6,
      "h": 5,
      "type": "chart",
      "title": "Répartition par état",
      "query": {
       "kind": "reference",
       "path": "/products-per-state.saiku"
      },
      "chartType": "pie"
     }
    ]
   }
  },
  {
   "id": "certifications",
   "title": "Certifications",
   "icon": "award",
   "heading": "Certifications et audits",
   "subheading": "Certifications par organisme, référentiel et usine",
