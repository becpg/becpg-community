{
 "id": "referentiel-produit",
 "name": "Référentiel produit",
 "version": 1,
 "theme": {
  "mode": "light",
  "ground": "#f4f7f8",
  "surface": "#ffffff",
  "fg": "#0d2b33",
  "muted": "#5b7780",
  "accent": "#009dcc"
 },
 "nav": {
  "position": "rail",
  "railFullHeight": true,
  "footer": {
   "settings": true
  }
 },
 "header": {
  "wordmarkAccent": "produit",
  "eyebrow": "beCPG",
  "liveBadge": "En direct"
 },
 "assistantSlot": {
  "enabled": true,
  "title": "Assistant produit",
  "persona": "Analyste du référentiel produit beCPG",
  "scope": "Répondre uniquement sur les cubes products, nutrients et lca.",
  "greeting": "Posez une question sur le portefeuille produit, la nutrition ou les coûts.",
  "suggestedPrompts": [
   "Répartition des produits par état",
   "Rentabilité moyenne par famille",
   "Produits par Nutri-Score"
  ],
  "cube": {
   "connectionName": "beCPG",
   "catalog": "beCPG OLAP Schema",
   "schema": "beCPG OLAP Schema",
   "cubeName": "products"
  }
 },
 "tags": [
  "beCPG",
  "produit"
 ],
 "pages": [
  {
   "id": "portefeuille",
   "title": "Portefeuille",
   "icon": "package",
   "heading": "Portefeuille produit",
   "subheading": "Volumes, prix, coûts et rentabilité par famille",
   "grid": {
    "cols": 12,
    "tiles": [
     {
      "id": "t1",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 5,
      "type": "table",
      "title": "Volumes, prix, coûts et rentabilité",
      "query": {
       "kind": "reference",
       "path": "/Portefeuille - volumes et marges.saiku"
      }
     },
     {
      "id": "t2",
      "x": 0,
      "y": 5,
      "w": 6,
      "h": 5,
      "type": "chart",
      "title": "Profit par famille",
      "query": {
       "kind": "reference",
       "path": "/Portefeuille - profit par famille.saiku"
      },
      "chartType": "bar"
     },
     {
      "id": "t3",
      "x": 6,
      "y": 5,
      "w": 6,
      "h": 5,
      "type": "chart",
      "title": "Répartition par état",
      "query": {
       "kind": "reference",
       "path": "/Nombre de produits par état.saiku"
