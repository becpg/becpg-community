{
 "id": "supplier-portal",
 "name": "Portail fournisseur",
 "version": 1,
 "theme": {
  "mode": "light",
  "ground": "#f4f7f8",
  "surface": "#ffffff",
  "fg": "#0d2b33",
  "muted": "#5b7780",
  "accent": "#009dcc"
 },
 "nav": {
  "position": "rail",
  "railFullHeight": true,
  "footer": {
   "settings": true
  }
 },
 "header": {
  "wordmarkAccent": "fournisseur",
  "eyebrow": "beCPG",
  "liveBadge": "En direct"
 },
 "assistantSlot": {
  "enabled": true,
  "title": "Assistant fournisseur",
  "persona": "Analyste des fournisseurs et de la conformité beCPG",
  "scope": "Répondre uniquement sur les cubes products, projectsSteps et requirements.",
  "greeting": "Posez une question sur les fournisseurs, leurs tâches ou la conformité.",
  "suggestedPrompts": [
   "Top 10 des fournisseurs",
   "Durée prévue contre réelle des tâches du portail",
   "Exigences non respectées"
  ],
  "cube": {
   "connectionName": "beCPG",
   "catalog": "beCPG OLAP Schema",
   "schema": "beCPG OLAP Schema",
   "cubeName": "products"
  }
 },
 "tags": [
  "beCPG",
  "fournisseur"
 ],
 "pages": [
  {
   "id": "fournisseurs",
   "title": "Fournisseurs",
   "icon": "users",
   "heading": "Panel fournisseurs",
   "subheading": "Poids des fournisseurs dans le référentiel",
   "grid": {
    "cols": 12,
    "tiles": [
     {
      "id": "t1",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 6,
      "type": "chart",
      "title": "Top 10 des fournisseurs",
      "query": {
       "kind": "reference",
       "path": "/top-10-suppliers.saiku"
      },
      "chartType": "bar"
     },
     {
      "id": "t2",
      "x": 0,
      "y": 6,
      "w": 12,
      "h": 5,
      "type": "chart",
      "title": "Matières premières les plus chères",
      "query": {
       "kind": "reference",
       "path": "/top-10-most-expensive-raw-materials-in-products.saiku"
      },
      "chartType": "bar"
     }
    ]
   }
  },
  {
   "id": "taches",
   "title": "Tâches",
   "icon": "clipboard",
   "heading": "Tâches du portail",
   "subheading": "Durées prévues et réelles",
   "grid": {
    "cols": 12,
    "tiles": [
     {
      "id": "t1",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 6,
      "type": "table",
      "title": "Durée prévisionnelle contre réelle",
      "query": {
       "kind": "reference",
       "path": "/supplier-portal-tasks-planned-vs-actual.saiku"
      }
     }
    ]
   }
  },
  {
   "id": "conformite",
   "title": "Conformité",
   "icon": "shield",
   "heading": "Conformité",
   "subheading": "Exigences non respectées et allergènes",
   "grid": {
    "cols": 12,
    "tiles": [
     {
      "id": "t1",
      "x": 0,
      "y": 0,
      "w": 7,
      "h": 6,
      "type": "chart",
      "title": "Exigences non respectées",
      "query": {
       "kind": "reference",
       "path": "/compliance-unmet-requirements.saiku"
      },
      "chartType": "bar"
     },
     {
      "id": "t2",
      "x": 7,
      "y": 0,
      "w": 5,
      "h": 6,
      "type": "chart",
      "title": "Top 10 des allergènes",
      "query": {
       "kind": "reference",
       "path": "/top-10-allergens.saiku"
      },
      "chartType": "bar"
     },
     {
      "id": "t3",
      "x": 0,
      "y": 6,
      "w": 12,
      "h": 5,
      "type": "chart",
      "title": "Non-conformités par fournisseur",
      "query": {
       "kind": "reference",
       "path": "/nc-by-supplier.saiku"
      },
      "chartType": "bar"
     }
    ]
   }
  },
  {
   "id": "certifications",
   "title": "Certifications",
   "icon": "award",
   "heading": "Certifications des sites",
   "subheading": "Certifications par organisme et par usine",
   "grid": {
    "cols": 12,
    "tiles": [
     {
      "id": "t6",
      "x": 0,
      "y": 0,
      "w": 6,
      "h": 5,
      "type": "table",
      "title": "Par organisme",
      "query": {
       "kind": "reference",
       "path": "/certifications-by-body.saiku"
      }
     },
     {
      "id": "t7",
      "x": 6,
      "y": 0,
      "w": 6,
      "h": 5,
      "type": "table",
      "title": "Par usine",
      "query": {
