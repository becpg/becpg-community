<#--
  Shared geometry and drawing macros of the regulatory nutrition facts panels.

  Units: 1 SVG user unit = 1 point, so every figure below is directly the measurement the
  regulation states. Never switch to pixels.

  Rules are drawn as <rect> and never as <line>: a line of width 0.25 straddles its coordinate
  and ends up anti-aliased over two device pixels, which is what makes a panel look off by a
  hair once printed. A rect has exact edges.

  Model access uses the method form (line.label(), not line.label): the model is made of Java
  records, and record accessors are not JavaBean getters, so FreeMarker only sees them as
  methods.
-->

<#-- Panel box -->
<#assign PANEL_W = 144>
<#assign PAD = 4>
<#assign CONTENT_W = PANEL_W - 2 * PAD>
<#assign RIGHT = PANEL_W - PAD>
<#assign BORDER = 0.5>

<#-- Rules, as thick as the regulation requires -->
<#assign HAIRLINE = 0.25>
<#assign RULE_MEDIUM = 3>
<#assign RULE_THICK = 7>

<#-- Type -->
<#assign FONT_BODY = "Helvetica, 'Nimbus Sans', Arial, 'Liberation Sans', sans-serif">
<#assign FONT_HEAVY = "'Helvetica Black', 'Arial Black', Helvetica, Arial, sans-serif">
<#assign TITLE_SIZE = 27>
<#assign SERVING_SIZE = 10>
<#assign CAPTION_SIZE = 6>
<#assign CALORIES_LABEL_SIZE = 16>
<#assign CALORIES_VALUE_SIZE = 22>
<#assign NUTRIENT_SIZE = 8>
<#assign FOOTNOTE_SIZE = 6>

<#-- Vertical rhythm -->
<#assign NUTRIENT_ROW_H = 11>
<#assign SERVING_ROW_H = 12>
<#assign CAPTION_ROW_H = 8>
<#assign CALORIES_ROW_H = 24>
<#assign FOOTNOTE_LINE_H = 7>
<#assign INDENT = 5.5>

<#-- Ratio of the Arial cap height to the font size, to place a baseline from the top of a line -->
<#assign ASCENT_RATIO = 0.716>

<#--
  Baseline of a text whose top edge sits at "top". The y attribute of an SVG text is its
  baseline, and dominant-baseline is not reliable enough in Batik to be used instead.
-->
<#function baseline top size>
	<#return top + size * ASCENT_RATIO>
</#function>

<#--
  Horizontal rule. It spans the content width by default, but the regulation asks for a
  shortened rule above a declaration nested under another one, "Includes Added Sugars" being
  the case the FDA spells out: the rule then starts at the indentation of the line it precedes.
-->
<#macro rule y height=HAIRLINE fromX=PAD>
	<rect x="${fromX}" y="${y}" width="${PANEL_W - PAD - fromX}" height="${height}"/>
</#macro>

<#-- Abscissa a rule starts at, given the line it sits above. -->
<#function ruleStart line>
	<#return (line.indentLevel() gte 3)?then(PAD + (line.indentLevel() - 1) * INDENT, PAD)>
</#function>

<#-- Panel border. Drawn as four rects so that its thickness is exact on every side. -->
<#macro border height>
	<rect x="0" y="0" width="${PANEL_W}" height="${BORDER}"/>
	<rect x="0" y="${height - BORDER}" width="${PANEL_W}" height="${BORDER}"/>
	<rect x="0" y="0" width="${BORDER}" height="${height}"/>
	<rect x="${PANEL_W - BORDER}" y="0" width="${BORDER}" height="${height}"/>
</#macro>

<#--
  Panel title. textLength forces the exact width whatever font the rendering host resolves,
  which keeps the panel identical when Helvetica Black is missing and Arial Black steps in,
  and when the wording changes with the language.
-->
<#macro title text y>
	<text x="${PAD}" y="${baseline(y, TITLE_SIZE)}" font-family="${FONT_HEAVY}" font-weight="900" font-size="${TITLE_SIZE}"
		textLength="${CONTENT_W}" lengthAdjust="spacingAndGlyphs">${text}</text>
</#macro>

<#-- A nutrient line: name, value, and the percent daily value pinned to the right margin. -->
<#macro nutrientRow line y>
	<#local top = y + 2>
	<#local base = baseline(top, NUTRIENT_SIZE)>
	<#local x = PAD + (line.indentLevel() - 1) * INDENT>
	<text x="${x}" y="${base}" font-size="${NUTRIENT_SIZE}"<#if line.bold()> font-family="${FONT_HEAVY}" font-weight="900"</#if>>${line.label()}<#if line.printsValue()> <tspan font-family="${FONT_BODY}" font-weight="normal">${line.value()}</tspan></#if></text>
	<#if line.hasDailyValue()>
	<text x="${RIGHT}" y="${base}" font-size="${NUTRIENT_SIZE}" font-family="${FONT_HEAVY}" font-weight="900" text-anchor="end">${line.dailyValuePercent()}</text>
	</#if>
</#macro>

<#--
  A pair of micronutrients on one line, separated by a drawn dot. The bullet is a circle and
  not a glyph: a typographic bullet shifts with the font and never lands on the centre.
-->
<#macro micronutrientPair pair y>
	<#local base = baseline(y + 2, NUTRIENT_SIZE)>
	<#local left = pair[0]>
	<text x="${PAD}" y="${base}" font-size="${NUTRIENT_SIZE}">${left.abbreviatedLabel()}<#if left.printsValue()> ${left.value()}</#if><#if left.hasDailyValue()> ${left.dailyValuePercent()}</#if></text>
	<#if (pair?size gt 1)>
	<#local right = pair[1]>
	<circle cx="${PANEL_W / 2}" cy="${base - NUTRIENT_SIZE * 0.3}" r="0.9"/>
	<text x="${RIGHT}" y="${base}" font-size="${NUTRIENT_SIZE}" text-anchor="end">${right.abbreviatedLabel()}<#if right.printsValue()> ${right.value()}</#if><#if right.hasDailyValue()> ${right.dailyValuePercent()}</#if></text>
	</#if>
</#macro>

<#--
  Vertical cursor left behind by panelBody, so that a format can size its svg once the body has
  been drawn. A macro cannot return a value, but an assignment made inside it lands in this
  namespace, which the calling template reads back as nf.cursorY.
-->
<#assign cursorY = 0>

<#--
  Everything a panel draws below its opening block: the thick rule, the calories, the daily
  value header, the two nutrient blocks and the footnote. Only the opening block differs from
  one regulation to the next, so this is what the formats share.

  A caption or a footnote with no wording is skipped rather than drawn empty, which is how a
  regulation that has no "Amount per serving" line opts out of it.
-->
<#macro panelBody data y footnoteChars=44 pairedMicronutrients=false>
	<#assign cursorY = y>

	<@rule y=cursorY height=RULE_THICK/>
	<#assign cursorY = cursorY + RULE_THICK + 1>

	<#if data.label("amountPerServing")?has_content>
	<text x="${PAD}" y="${baseline(cursorY, CAPTION_SIZE)}" font-size="${CAPTION_SIZE}" font-family="${FONT_HEAVY}" font-weight="900">${data.label("amountPerServing")}</text>
	<#assign cursorY = cursorY + CAPTION_ROW_H>
	</#if>

	<#if data.calories()??>
	<text x="${PAD}" y="${baseline(cursorY, CALORIES_VALUE_SIZE)}" font-family="${FONT_HEAVY}" font-weight="900" font-size="${CALORIES_LABEL_SIZE}">${data.calories().label()}</text>
	<#if data.calories().value()??>
	<text x="${RIGHT}" y="${baseline(cursorY, CALORIES_VALUE_SIZE)}" font-family="${FONT_HEAVY}" font-weight="900" font-size="${CALORIES_VALUE_SIZE}" text-anchor="end">${data.calories().value()}</text>
	</#if>
	<#assign cursorY = cursorY + CALORIES_ROW_H>
	</#if>

	<@rule y=cursorY height=RULE_MEDIUM/>
	<#assign cursorY = cursorY + RULE_MEDIUM + 1>

	<text x="${RIGHT}" y="${baseline(cursorY, CAPTION_SIZE)}" font-size="${CAPTION_SIZE}" font-family="${FONT_HEAVY}" font-weight="900" text-anchor="end">${data.label("dailyValue")}</text>
	<#assign cursorY = cursorY + CAPTION_ROW_H>

	<#list data.nutrients() as line>
	<@rule y=cursorY fromX=ruleStart(line)/>
	<#assign cursorY = cursorY + HAIRLINE>
	<@nutrientRow line=line y=cursorY/>
	<#assign cursorY = cursorY + NUTRIENT_ROW_H>
	</#list>

	<#if data.micronutrients()?has_content>
	<@rule y=cursorY height=RULE_THICK/>
	<#assign cursorY = cursorY + RULE_THICK>
	<#if pairedMicronutrients>
	<#list data.micronutrients()?chunk(2) as pair>
	<#if (pair?index gt 0)>
	<@rule y=cursorY/>
	<#assign cursorY = cursorY + HAIRLINE>
	</#if>
	<@micronutrientPair pair=pair y=cursorY/>
	<#assign cursorY = cursorY + NUTRIENT_ROW_H>
	</#list>
	<#else>
	<#list data.micronutrients() as line>
	<#if (line?index gt 0)>
	<@rule y=cursorY/>
	<#assign cursorY = cursorY + HAIRLINE>
	</#if>
	<@nutrientRow line=line y=cursorY/>
	<#assign cursorY = cursorY + NUTRIENT_ROW_H>
	</#list>
	</#if>
	</#if>

	<#if data.footNote()?has_content>
	<@rule y=cursorY height=RULE_MEDIUM/>
	<#assign cursorY = cursorY + RULE_MEDIUM + 1>
	<#list wrap(data.footNote(), footnoteChars) as footNoteLine>
	<text x="${PAD}" y="${baseline(cursorY, FOOTNOTE_SIZE)}" font-size="${FOOTNOTE_SIZE}">${footNoteLine}</text>
	<#assign cursorY = cursorY + FOOTNOTE_LINE_H>
	</#list>
	</#if>

	<#assign cursorY = cursorY + BORDER + 1>
</#macro>

<#--
  Body of the dual column format, 21 CFR 101.9(e)(6)(i): the same nutrients, but two columns of
  figures, one per serving and one per container, each with its own amount and percentage.
  Required when a container holds a small number of servings and could be eaten in one go.

  Four columns of figures do not fit the width of a vertical panel, so this format is drawn
  wider and every column position is derived from that width.
-->
<#macro dualColumnBody data y width footnoteChars=70>
	<#assign cursorY = y>
	<#-- Deux colonnes strictement de meme largeur : retour client du 23/07 sur le format 3. -->
	<#-- La colonne des libelles doit loger "Total Carbohydrate" en Black sans toucher les chiffres. -->
	<#local labelW = 104>
	<#local columnW = (width - PAD - labelW) / 2>
	<#local servingValueX = labelW + columnW * 0.60>
	<#local servingPercentX = labelW + columnW>
	<#local containerValueX = labelW + columnW + columnW * 0.60>
	<#local containerPercentX = labelW + 2 * columnW>

	<@ruleOfWidth y=cursorY height=RULE_THICK width=width/>
	<#assign cursorY = cursorY + RULE_THICK + 2>

	<text x="${servingPercentX}" y="${baseline(cursorY, CAPTION_SIZE)}" font-size="${CAPTION_SIZE}" font-weight="bold" text-anchor="end">${data.label("perServing")}</text>
	<text x="${containerPercentX}" y="${baseline(cursorY, CAPTION_SIZE)}" font-size="${CAPTION_SIZE}" font-weight="bold" text-anchor="end">${data.label("perContainer")}</text>
	<#assign cursorY = cursorY + CAPTION_ROW_H>

	<#if data.calories()??>
	<text x="${PAD}" y="${baseline(cursorY, CALORIES_LABEL_SIZE)}" font-family="${FONT_HEAVY}" font-weight="900" font-size="${CALORIES_LABEL_SIZE}">${data.calories().label()}</text>
	<#if data.calories().value()??>
	<text x="${servingPercentX}" y="${baseline(cursorY, CALORIES_LABEL_SIZE)}" font-family="${FONT_HEAVY}" font-weight="900" font-size="${CALORIES_LABEL_SIZE}" text-anchor="end">${data.calories().value()}</text>
	</#if>
	<#if data.calories().valuePerContainer()??>
	<text x="${containerPercentX}" y="${baseline(cursorY, CALORIES_LABEL_SIZE)}" font-family="${FONT_HEAVY}" font-weight="900" font-size="${CALORIES_LABEL_SIZE}" text-anchor="end">${data.calories().valuePerContainer()}</text>
	</#if>
	<#assign cursorY = cursorY + CALORIES_LABEL_SIZE + 3>
	</#if>

	<@ruleOfWidth y=cursorY height=RULE_MEDIUM width=width/>
	<#assign cursorY = cursorY + RULE_MEDIUM + 1>

	<text x="${servingPercentX}" y="${baseline(cursorY, CAPTION_SIZE)}" font-size="${CAPTION_SIZE}" font-weight="bold" text-anchor="end">${data.label("dailyValue")}</text>
	<text x="${containerPercentX}" y="${baseline(cursorY, CAPTION_SIZE)}" font-size="${CAPTION_SIZE}" font-weight="bold" text-anchor="end">${data.label("dailyValue")}</text>
	<#assign cursorY = cursorY + CAPTION_ROW_H>

	<#list data.nutrients() + data.micronutrients() as line>
	<@ruleOfWidth y=cursorY height=HAIRLINE width=width fromX=ruleStart(line)/>
	<#assign cursorY = cursorY + HAIRLINE>
	<@dualColumnRow line=line y=cursorY servingValueX=servingValueX servingPercentX=servingPercentX
		containerValueX=containerValueX containerPercentX=containerPercentX/>
	<#assign cursorY = cursorY + NUTRIENT_ROW_H>
	</#list>

	<#if data.footNote()?has_content>
	<@ruleOfWidth y=cursorY height=RULE_MEDIUM width=width/>
	<#assign cursorY = cursorY + RULE_MEDIUM + 1>
	<#list wrap(data.footNote(), footnoteChars) as footNoteLine>
	<text x="${PAD}" y="${baseline(cursorY, FOOTNOTE_SIZE)}" font-size="${FOOTNOTE_SIZE}">${footNoteLine}</text>
	<#assign cursorY = cursorY + FOOTNOTE_LINE_H>
	</#list>
	</#if>

	<#assign cursorY = cursorY + BORDER + 1>
</#macro>

<#--
  One nutrient across the four columns of figures. The name is printed alone, its amount going
  to the serving column, so that nothing overlaps whatever the length of the wording.
-->
<#macro dualColumnRow line y servingValueX servingPercentX containerValueX containerPercentX>
	<#local top = y + 2>
	<#local base = baseline(top, NUTRIENT_SIZE)>
	<#local x = PAD + (line.indentLevel() - 1) * INDENT>
	<text x="${x}" y="${base}" font-size="${NUTRIENT_SIZE}"<#if line.bold()> font-family="${FONT_HEAVY}" font-weight="900"</#if>>${line.plainLabel()}</text>
	<#if line.value()??>
	<text x="${servingValueX}" y="${base}" font-size="${NUTRIENT_SIZE}" text-anchor="end">${line.value()}</text>
	</#if>
	<#if line.hasDailyValue()>
	<text x="${servingPercentX}" y="${base}" font-size="${NUTRIENT_SIZE}" font-family="${FONT_HEAVY}" font-weight="900" text-anchor="end">${line.dailyValuePercent()}</text>
	</#if>
	<#if line.valuePerContainer()??>
	<text x="${containerValueX}" y="${base}" font-size="${NUTRIENT_SIZE}" text-anchor="end">${line.valuePerContainer()}</text>
	</#if>
	<#if line.dailyValuePercentPerContainer()??>
	<text x="${containerPercentX}" y="${base}" font-size="${NUTRIENT_SIZE}" font-family="${FONT_HEAVY}" font-weight="900" text-anchor="end">${line.dailyValuePercentPerContainer()}</text>
	</#if>
</#macro>

<#--
  Run-on sentence of the linear format, 21 CFR 101.9(j)(13)(ii)(A)(2). Nutrients are named by
  their abbreviation and their percentage is parenthesised, the whole panel being a single
  paragraph rather than a table.
-->
<#function linearSentence data>
	<#local parts = []>
	<#list data.nutrients() + data.micronutrients() as line>
		<#local part = line.abbreviatedLabel()>
		<#if line.value()??><#local part = part + " " + line.value()></#if>
		<#if line.hasDailyValue()><#local part = part + " (" + line.dailyValuePercent() + " DV)"></#if>
		<#local parts = parts + [part]>
	</#list>
	<#return parts?join(", ")>
</#function>

<#-- The svg envelope, identical for every format: white ground, border, then the drawn body. -->
<#macro panel height>
<svg xmlns="http://www.w3.org/2000/svg" width="${PANEL_W}pt" height="${height}pt" viewBox="0 0 ${PANEL_W} ${height}"
	preserveAspectRatio="xMinYMin meet" font-family="${FONT_BODY}" fill="#000000">
	<rect x="0" y="0" width="${PANEL_W}" height="${height}" fill="#ffffff"/>
	<@border height=height/>
	<#nested>
</svg>
</#macro>


<#--
  Body of the tabular format, 21 CFR 101.9(d)(11)(iii). The declaration is laid out across the
  width instead of down the height: the nutrients are split into two columns of figures, which
  is what lets a wide, short package carry a full panel.

  The panel width is passed in, this format being drawn wider than the vertical ones.
-->
<#macro tabularBody data y width footnoteChars=100>
	<#assign cursorY = y>
	<#local right = width - PAD>
	<#local half = (width - 2 * PAD) / 2>
	<#local columnPercent = PAD + half - 2>
	<#local secondLabel = PAD + half + 4>
	<#local secondPercent = right>

	<@ruleOfWidth y=cursorY height=RULE_THICK width=width/>
	<#assign cursorY = cursorY + RULE_THICK + 1>

	<#if data.calories()??>
	<text x="${PAD}" y="${baseline(cursorY, CALORIES_LABEL_SIZE)}" font-family="${FONT_HEAVY}" font-weight="900" font-size="${CALORIES_LABEL_SIZE}">${data.calories().label()}<#if data.calories().value()??> ${data.calories().value()}</#if></text>
	<text x="${right}" y="${baseline(cursorY, CAPTION_SIZE)}" font-size="${CAPTION_SIZE}" font-weight="bold" text-anchor="end">${data.label("dailyValue")}</text>
	<#assign cursorY = cursorY + CALORIES_LABEL_SIZE + 2>
	</#if>

	<@ruleOfWidth y=cursorY height=RULE_MEDIUM width=width/>
	<#assign cursorY = cursorY + RULE_MEDIUM + 1>

	<#local columns = data.nutrients()?chunk(((data.nutrients()?size + 1) / 2)?floor)>
	<#local rows = columns[0]?size>
	<#local top = cursorY>
	<#list 0..(rows - 1) as index>
	<@ruleOfWidth y=cursorY height=HAIRLINE width=width/>
	<#assign cursorY = cursorY + HAIRLINE>
	<@tabularRow line=columns[0][index] y=cursorY labelX=PAD percentX=columnPercent/>
	<#if (columns?size gt 1) && (columns[1]?size gt index)>
	<@tabularRow line=columns[1][index] y=cursorY labelX=secondLabel percentX=secondPercent/>
	</#if>
	<#assign cursorY = cursorY + NUTRIENT_ROW_H>
	</#list>
	<rect x="${PAD + half}" y="${top}" width="${HAIRLINE}" height="${cursorY - top}"/>

	<#if data.micronutrients()?has_content>
	<@ruleOfWidth y=cursorY height=RULE_THICK width=width/>
	<#assign cursorY = cursorY + RULE_THICK + 1>
	<#local micro = []>
	<#list data.micronutrients() as line>
		<#local micro = micro + [line.label() + (line.value()?has_content)?then(" " + line.value(), "") + (line.hasDailyValue())?then(" " + line.dailyValuePercent(), "")]>
	</#list>
	<text x="${PAD}" y="${baseline(cursorY, NUTRIENT_SIZE)}" font-size="${NUTRIENT_SIZE}">${micro?join("  •  ")}</text>
	<#assign cursorY = cursorY + NUTRIENT_ROW_H>
	</#if>

	<#if data.footNote()?has_content>
	<@ruleOfWidth y=cursorY height=RULE_MEDIUM width=width/>
	<#assign cursorY = cursorY + RULE_MEDIUM + 1>
	<#list wrap(data.footNote(), footnoteChars) as footNoteLine>
	<text x="${PAD}" y="${baseline(cursorY, FOOTNOTE_SIZE)}" font-size="${FOOTNOTE_SIZE}">${footNoteLine}</text>
	<#assign cursorY = cursorY + FOOTNOTE_LINE_H>
	</#list>
	</#if>

	<#assign cursorY = cursorY + BORDER + 1>
</#macro>

<#macro tabularRow line y labelX percentX>
	<#local base = baseline(y + 2, NUTRIENT_SIZE)>
	<#local x = labelX + (line.indentLevel() - 1) * INDENT>
	<text x="${x}" y="${base}" font-size="${NUTRIENT_SIZE}"<#if line.bold()> font-weight="bold"</#if>>${line.label()}<#if line.value()??> <tspan font-weight="normal">${line.value()}</tspan></#if></text>
	<#if line.hasDailyValue()>
	<text x="${percentX}" y="${base}" font-size="${NUTRIENT_SIZE}" font-weight="bold" text-anchor="end">${line.dailyValuePercent()}</text>
	</#if>
</#macro>

<#-- Rule spanning a panel of arbitrary width, the tabular format being wider than the others. -->
<#macro ruleOfWidth y height width fromX=PAD>
	<rect x="${fromX}" y="${y}" width="${width - PAD - fromX}" height="${height}"/>
</#macro>

<#-- Envelope of a panel drawn at a width other than the standard one. -->
<#macro panelOfWidth height width>
<svg xmlns="http://www.w3.org/2000/svg" width="${width}pt" height="${height}pt" viewBox="0 0 ${width} ${height}"
	preserveAspectRatio="xMinYMin meet" font-family="${FONT_BODY}" fill="#000000">
	<rect x="0" y="0" width="${width}" height="${height}" fill="#ffffff"/>
	<rect x="0" y="0" width="${width}" height="${BORDER}"/>
	<rect x="0" y="${height - BORDER}" width="${width}" height="${BORDER}"/>
	<rect x="0" y="0" width="${BORDER}" height="${height}"/>
	<rect x="${width - BORDER}" y="0" width="${BORDER}" height="${height}"/>
	<#nested>
</svg>
</#macro>

<#--
  Greedy word wrap, by character count. The footnote is the only free text of a panel and it
  never has to align with anything, so an approximate measure is enough here; a glyph accurate
  wrap would need the font metrics.
-->
<#function wrap text charsPerLine>
	<#local lines = []>
	<#local current = "">
	<#list text?trim?split(r"\s+", "r") as word>
		<#if current?length == 0>
			<#local current = word>
		<#elseif (current?length + 1 + word?length) lte charsPerLine>
			<#local current = current + " " + word>
		<#else>
			<#local lines = lines + [current]>
			<#local current = word>
		</#if>
	</#list>
	<#if (current?length gt 0)>
		<#local lines = lines + [current]>
	</#if>
	<#return lines>
</#function>
