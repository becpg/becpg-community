<#--
  Shared geometry and drawing macros of the regulatory nutrition facts panels.

  Units: 1 SVG user unit = 1 point, so every figure below is directly the measurement the
  regulation states. Never switch to pixels.

  Rules are drawn as <rect> and never as <line>: a line of width 0.25 straddles its coordinate
  and ends up anti-aliased over two device pixels, which is what makes a panel look off by a
  hair once printed. A rect has exact edges.

  Model access uses the method form (line.label(), not line.label): the model is made of Java
  records, and record accessors are not JavaBean getters, so FreeMarker only sees them as
  methods.

  The primitives that do not depend on a panel, rules, frame, envelope, baselines and wrap, live
  in svg-lib.ftlx and are shared with the score markings; the macros below keep their signatures
  and only lay them out on the panel geometry.
-->
<#import "svg-lib.ftlx" as svg>

<#-- Panel box -->
<#assign PANEL_W = 144>
<#assign PAD = 4>
<#assign BORDER = 0.5>

<#--
  Width of the panel being drawn. Every macro below derives from it, so a format wider than a
  vertical panel declares its own width once, before it draws anything:

    <#assign W = 252 in nf>
-->
<#assign W = PANEL_W>

<#-- Right margin the figures are pinned to. -->
<#function right>
	<#return W - PAD>
</#function>

<#-- Width available between the two margins. -->
<#function contentWidth>
	<#return W - 2 * PAD>
</#function>

<#-- Rules, as thick as the regulation requires -->
<#assign HAIRLINE = 0.25>
<#assign RULE_MEDIUM = 3>
<#assign RULE_THICK = 7>

<#--
  Type. A single face, Arial, emphasis being carried by its bold weight rather than by a black
  face: the regulation names no typeface, Arial is installed wherever reports are rendered, and
  Liberation Sans stands in for it glyph for glyph where it is missing.
-->
<#assign FONT_FAMILY = svg.FONT_FAMILY>

<#--
  Condensed face, which the Canadian horizontal format sets its nutrients in. Liberation Sans Narrow
  and Nimbus Sans Narrow come first: both are installed in regular and bold wherever reports are
  rendered, where Arial Narrow is often only there in bold.
-->
<#assign CONDENSED_FONT_FAMILY = "'Liberation Sans Narrow', 'Nimbus Sans Narrow', 'Arial Narrow', Arial, sans-serif">
<#assign HEAVY_WEIGHT = "bold">
<#assign TITLE_SIZE = 27>
<#assign SERVING_SIZE = 10>
<#assign CAPTION_SIZE = 6>
<#assign CALORIES_LABEL_SIZE = 16>
<#assign CALORIES_VALUE_SIZE = 22>
<#assign NUTRIENT_SIZE = 8>
<#assign FOOTNOTE_SIZE = 5>

<#-- Vertical rhythm -->
<#assign NUTRIENT_ROW_H = 11>
<#assign SERVING_ROW_H = 12>
<#assign CAPTION_ROW_H = 8>
<#assign INDENT = 5.5>

<#--
  No-break space. It joins the words of a nutrient name, or of a whole declaration, that a wrapped
  line must never split: the wrap breaks on plain whitespace only.
-->
<#assign NBSP = "\xA0">

<#--
  Word a regulation sets in italics wherever a nutrient name carries it, "Trans" for the FDA.
  A format declares it once, before it draws anything, the way it declares its width:

    <#assign ITALIC_WORD = nf_data.label("italicWord") in nf>
-->
<#assign ITALIC_WORD = "">

<#-- Air kept between a vertical rule, or the edge of a column, and the figures next to it. -->
<#assign CELL_INSET = 4>

<#-- Air a horizontal rule leaves on each side of a vertical rule it stops at. -->
<#assign COLUMN_RULE_GAP = 1.5>

<#-- Air kept above a caption that a rule would otherwise touch -->
<#assign CAPTION_LEAD = 3>

<#-- Ratio of the Arial cap height to the font size, to place a baseline from the top of a line -->
<#assign ASCENT_RATIO = svg.ASCENT_RATIO>

<#--
  Average width of a glyph, as a ratio of the font size, used to wrap free text. Measured on
  Arial and on the metrically compatible faces the panels fall back to. Prose runs narrower than
  a sentence stating figures, digits and parentheses being wider than letters, and the bold weight
  runs wider than both, so the wrap counts a line with the ratio matching what it holds.
-->
<#assign GLYPH_RATIO = svg.GLYPH_RATIO>
<#assign FIGURE_GLYPH_RATIO = 0.53>
<#assign HEAVY_GLYPH_RATIO = 0.55>

<#--
  Advance widths of Arial Bold, as a ratio of the font size, by class of glyph. Where an average
  ratio is enough to wrap prose, deciding whether two texts share a line needs a closer measure:
  a serving size is mostly figures and parentheses, much narrower than letters.
-->
<#assign NARROW_GLYPHS = " ijlftr.,:;()[]/'!|-">
<#assign WIDE_GLYPHS = "mwMW%">
<#assign NARROW_HEAVY_RATIO = 0.31>
<#assign WIDE_HEAVY_RATIO = 0.86>
<#assign CAPITAL_HEAVY_RATIO = 0.72>
<#assign DIGIT_HEAVY_RATIO = 0.556>
<#assign LETTER_HEAVY_RATIO = 0.58>

<#--
  Baseline of a text whose top edge sits at "top". The y attribute of an SVG text is its
  baseline, and dominant-baseline is not reliable enough in Batik to be used instead.
-->
<#function baseline top size>
	<#return svg.baseline(top, size)>
</#function>

<#-- Height a text of that size takes, its descender included. -->
<#function lineHeight size>
	<#return svg.lineHeight(size)>
</#function>

<#-- How many glyphs of that size fit in a width, which is what the free text wrap counts in. -->
<#function charsPerWidth width size ratio=GLYPH_RATIO>
	<#return svg.charsPerWidth(width, size, ratio)>
</#function>

<#--
  Horizontal rule. It spans the content width by default, but the regulation asks for a
  shortened rule above a declaration nested under another one, "Includes Added Sugars" being
  the case the FDA spells out: the rule then starts at the indentation of the line it precedes.

  It can also stop short of the right margin, which is how a Canadian panel closes its calories:
  the rule runs to the middle of the panel and leaves the daily value header standing free.
-->
<#macro rule y height=HAIRLINE fromX=PAD toX=-1>
	<#local end = (toX gte 0)?then(toX, W - PAD)>
	<@svg.band x=fromX y=y width=end - fromX height=height/>
</#macro>

<#-- Horizontal rule spanning a single band of a panel laid out across its width. -->
<#macro bandRule x y width height=HAIRLINE>
	<@svg.band x=x y=y width=width height=height/>
</#macro>

<#-- Vertical rule, separating two columns of figures. -->
<#macro columnRule x fromY toY>
	<@svg.verticalRule x=x fromY=fromY toY=toY width=HAIRLINE/>
</#macro>

<#-- Abscissa a rule starts at, given the line it sits above. -->
<#function ruleStart line>
	<#return (line.indentLevel() gte 3)?then(PAD + (line.indentLevel() - 1) * INDENT, PAD)>
</#function>

<#-- Panel border. Drawn as four rects so that its thickness is exact on every side. -->
<#macro border height>
	<@svg.frame width=W height=height thickness=BORDER/>
</#macro>

<#-- Width a text set in the bold weight takes, measured glyph by glyph. -->
<#function heavyWidth text size>
	<#local units = 0>
	<#list 0..<text?length as index>
	<#local units = units + heavyGlyphRatio(text[index])>
	</#list>
	<#return units * size>
</#function>

<#function heavyGlyphRatio glyph>
	<#if NARROW_GLYPHS?contains(glyph)>
	<#return NARROW_HEAVY_RATIO>
	<#elseif WIDE_GLYPHS?contains(glyph)>
	<#return WIDE_HEAVY_RATIO>
	<#elseif glyph?matches("[0-9]")>
	<#return DIGIT_HEAVY_RATIO>
	<#elseif glyph != glyph?lower_case>
	<#return CAPITAL_HEAVY_RATIO>
	</#if>
	<#return LETTER_HEAVY_RATIO>
</#function>

<#--
  "Serving size" on the left margin and the serving itself on the right one. A serving too long
  to stand beside its wording, half an em of air kept between them, goes to the next line rather
  than running into it. Leaves the ordinate under the serving in cursorY.
-->
<#macro servingSizeLine data y size=SERVING_SIZE rowHeight=SERVING_ROW_H>
	<#local wording = data.label("servingSize")>
	<#assign cursorY = y>
	<text x="${PAD}" y="${baseline(cursorY, size)}" font-size="${size}" font-weight="${HEAVY_WEIGHT}">${wording}</text>
	<#if data.serving().servingSize()??>
	<#local serving = data.serving().servingSize()>
	<#if (heavyWidth(wording, size) + size / 2 + heavyWidth(serving, size) gt contentWidth())>
	<#assign cursorY = cursorY + rowHeight>
	</#if>
	<text x="${right()}" y="${baseline(cursorY, size)}" font-size="${size}" font-weight="${HEAVY_WEIGHT}" text-anchor="end">${serving}</text>
	</#if>
	<#assign cursorY = cursorY + rowHeight>
</#macro>

<#--
  Panel title. textLength forces the exact width whatever font the rendering host resolves,
  which keeps the panel identical when Arial is missing and another face steps in, and when
  the wording changes with the language.
-->
<#macro title text y size=TITLE_SIZE>
	<text x="${PAD}" y="${baseline(y, size)}" font-weight="${HEAVY_WEIGHT}" font-size="${size}"
		textLength="${contentWidth()}" lengthAdjust="spacingAndGlyphs">${text}</text>
</#macro>

<#--
  A nutrient line: name, value, and the percent daily value pinned to the right margin.

  The regulation sets the percentages of the mandatory nutrients in the heavy face and leaves
  those of the vitamins and minerals in the body face, hence boldPercent.

  A percentage covering two lines is dropped half a line down so that it reads as belonging to
  both, which is how the Canadian panel states saturated and trans fat together.
-->
<#macro nutrientRow line y boldPercent=true>
	<@nutrientRowAt line=line base=baseline(y + 2, NUTRIENT_SIZE) boldPercent=boldPercent percentShift=sharedPercentShift(line)/>
</#macro>

<#--
  The same line drawn on a given baseline, which is how a format stating its leadings from one
  baseline to the next places it. The percentage is dropped by percentShift below that baseline.
-->
<#macro nutrientRowAt line base boldPercent=true indent=INDENT percentShift=0>
	<#local x = PAD + (line.indentLevel() - 1) * indent>
	<text x="${x}" y="${base}" font-size="${NUTRIENT_SIZE}"<#if line.bold()> font-weight="${HEAVY_WEIGHT}"</#if>><@wording text=line.label()/><#if line.printsValue()> <tspan font-weight="normal">${line.value()}</tspan></#if></text>
	<#if line.hasDailyValue()>
	<text x="${right()}" y="${base + percentShift}" font-size="${NUTRIENT_SIZE}"<#if boldPercent> font-weight="${HEAVY_WEIGHT}"</#if> text-anchor="end">${line.dailyValuePercent()}</text>
	</#if>
</#macro>

<#-- How far below its own baseline a percentage sits when it covers the line under it as well. -->
<#function sharedPercentShift line>
	<#return line.hasSharedDailyValue()?then(NUTRIENT_ROW_H / 2, 0)>
</#function>

<#--
  A pair of micronutrients on one line, separated by a drawn dot. The bullet is a circle and
  not a glyph: a typographic bullet shifts with the font and never lands on the centre.
-->
<#macro micronutrientPair pair y>
	<#local base = baseline(y + 2, NUTRIENT_SIZE)>
	<#local first = pair[0]>
	<text x="${PAD}" y="${base}" font-size="${NUTRIENT_SIZE}">${first.abbreviatedLabel()}<#if first.printsValue()> ${first.value()}</#if><#if first.hasDailyValue()> ${first.dailyValuePercent()}</#if></text>
	<#if (pair?size gt 1)>
	<#local second = pair[1]>
	<circle cx="${W / 2}" cy="${base - NUTRIENT_SIZE * 0.3}" r="0.9"/>
	<text x="${right()}" y="${base}" font-size="${NUTRIENT_SIZE}" text-anchor="end">${second.abbreviatedLabel()}<#if second.printsValue()> ${second.value()}</#if><#if second.hasDailyValue()> ${second.dailyValuePercent()}</#if></text>
	</#if>
</#macro>

<#--
  Vertical cursor left behind by panelBody, so that a format can size its svg once the body has
  been drawn. A macro cannot return a value, but an assignment made inside it lands in this
  namespace, which the calling template reads back as nf.cursorY.
-->
<#assign cursorY = 0>

<#--
  Everything a panel draws below its opening block: the thick rule, the calories, the daily
  value header, the two nutrient blocks and the footnote. Only the opening block differs from
  one regulation to the next, so this is what the formats share.

  A caption or a footnote with no wording is skipped rather than drawn empty, which is how a
  regulation that has no "Amount per serving" line opts out of it.
-->
<#macro panelBody data y pairedMicronutrients=false>
	<#assign cursorY = y>

	<@rule y=cursorY height=RULE_THICK/>
	<#assign cursorY = cursorY + RULE_THICK + CAPTION_LEAD>

	<#if data.label("amountPerServing")?has_content>
	<text x="${PAD}" y="${baseline(cursorY, CAPTION_SIZE)}" font-size="${CAPTION_SIZE}" font-weight="${HEAVY_WEIGHT}">${data.label("amountPerServing")}</text>
	<#assign cursorY = cursorY + CAPTION_ROW_H>
	</#if>

	<#if data.calories()??>
	<text x="${PAD}" y="${baseline(cursorY, CALORIES_VALUE_SIZE)}" font-weight="${HEAVY_WEIGHT}" font-size="${CALORIES_LABEL_SIZE}">${data.calories().label()}</text>
	<#if data.calories().value()??>
	<text x="${right()}" y="${baseline(cursorY, CALORIES_VALUE_SIZE)}" font-weight="${HEAVY_WEIGHT}" font-size="${CALORIES_VALUE_SIZE}" text-anchor="end">${data.calories().value()}</text>
	</#if>
	<#assign cursorY = cursorY + lineHeight(CALORIES_VALUE_SIZE)>
	</#if>

	<@rule y=cursorY height=RULE_MEDIUM/>
	<#assign cursorY = cursorY + RULE_MEDIUM + CAPTION_LEAD>

	<text x="${right()}" y="${baseline(cursorY, CAPTION_SIZE)}" font-size="${CAPTION_SIZE}" font-weight="${HEAVY_WEIGHT}" text-anchor="end">${data.label("dailyValue")}</text>
	<#assign cursorY = cursorY + CAPTION_ROW_H + 1>

	<#list data.nutrients() as line>
	<@rule y=cursorY fromX=ruleStart(line)/>
	<#assign cursorY = cursorY + HAIRLINE>
	<@nutrientRow line=line y=cursorY/>
	<#assign cursorY = cursorY + NUTRIENT_ROW_H>
	</#list>

	<#if data.micronutrients()?has_content>
	<@rule y=cursorY height=RULE_THICK/>
	<#assign cursorY = cursorY + RULE_THICK>
	<#if pairedMicronutrients>
	<#list data.micronutrients()?chunk(2) as pair>
	<#if (pair?index gt 0)>
	<@rule y=cursorY/>
	<#assign cursorY = cursorY + HAIRLINE>
	</#if>
	<@micronutrientPair pair=pair y=cursorY/>
	<#assign cursorY = cursorY + NUTRIENT_ROW_H>
	</#list>
	<#else>
	<#list data.micronutrients() as line>
	<#if (line?index gt 0)>
	<@rule y=cursorY/>
	<#assign cursorY = cursorY + HAIRLINE>
	</#if>
	<@nutrientRow line=line y=cursorY boldPercent=false/>
	<#assign cursorY = cursorY + NUTRIENT_ROW_H>
	</#list>
	</#if>
	</#if>

	<#if data.footNote()?has_content>
	<@rule y=cursorY height=RULE_MEDIUM/>
	<#assign cursorY = cursorY + RULE_MEDIUM + 1>
	<@footNote text=data.footNote() y=cursorY/>
	</#if>

	<#assign cursorY = cursorY + BORDER + 1>
</#macro>

<#--
  The two languages of a bilingual panel gathered on one line, "Fat / Lipides", which is how a
  panel written as a sentence states them. A wording that reads the same in both is stated once.
-->
<#function joined primary secondary>
	<#if !secondary?has_content || (primary == secondary)>
	<#return primary>
	</#if>
	<#return primary + " / " + secondary>
</#function>

<#-- Daily value header of a panel, one line per language it is written in. -->
<#function dailyValueHeaders data>
	<#local headers = [data.label("dailyValue")]>
	<#if data.isBilingual() && data.secondaryLabel("dailyValue")?has_content>
	<#local headers = headers + [data.secondaryLabel("dailyValue")]>
	</#if>
	<#return headers>
</#function>

<#--
  Sentence broken into styled runs, the given wordings being the ones the regulation sets in the
  heavy face: the Canadian footnote emphasises its two verdicts, "5% or less is a little".

  The runs keep the spacing of the sentence exactly, so they are drawn by styledLine and not by
  the paragraph macro, which measures words to wrap them and would lose the punctuation.
-->
<#function emphasise sentence words>
	<#local segments = [text(sentence)]>
	<#list words?split(",") as word>
		<#if word?trim?has_content>
		<#local segments = highlight(segments, word?trim)>
		</#if>
	</#list>
	<#return segments>
</#function>

<#-- Same runs, with every occurrence of one wording pulled out into a run of its own. -->
<#function highlight segments word>
	<#local result = []>
	<#list segments as segment>
		<#if segment.bold || !segment.text?contains(word)>
		<#local result = result + [segment]>
		<#else>
		<#list segment.text?split(word) as part>
			<#if (part?index gt 0)>
			<#local result = result + [emphasis(word)]>
			</#if>
			<#if part?has_content>
			<#local result = result + [text(part)]>
			</#if>
		</#list>
		</#if>
	</#list>
	<#return result>
</#function>

<#-- One drawn line of styled runs, keeping the spacing of the sentence it comes from. -->
<#macro styledLine segments y size=FOOTNOTE_SIZE indent=PAD anchor="start">
	<@styledLineAt segments=segments base=baseline(y, size) size=size indent=indent anchor=anchor/>
</#macro>

<#--
  The same line drawn on a given baseline. A Canadian panel sets the asterisk opening its footnote
  apart, in the size and the weight the directory states for it, hence asterisks.
-->
<#macro styledLineAt segments base size=FOOTNOTE_SIZE indent=PAD anchor="start" asterisks=false>
	<text x="${indent}" y="${base}" font-size="${size}" xml:space="preserve"<#if anchor != "start"> text-anchor="${anchor}"</#if>><#list segments as segment><#if segment.bold><tspan font-weight="${HEAVY_WEIGHT}">${segment.text}</tspan><#elseif asterisks><@asterisked text=segment.text/><#else>${segment.text}</#if></#list></text>
</#macro>

<#--
  Footnote of a panel, one sentence per language, the regulated wordings in the heavy face, each
  sentence wrapped to the width it is given: the directory of formats lets the footnote run over
  more than one line rather than overflow a narrow table.

  A panel drawn across the package has the room to state both languages on the same line, and
  states them there, parted by a slash, rather than stacking two lines under a table that is only
  a few lines tall.
-->
<#macro emphasisedFootNote data y size=FOOTNOTE_SIZE indent=PAD width=-1 singleLine=false anchor="start">
	<#assign cursorY = y>
	<#list footNoteLines(data, size, width, singleLine) as segments>
	<@styledLine segments=segments y=cursorY size=size indent=indent anchor=anchor/>
	<#assign cursorY = cursorY + lineHeight(size)>
	</#list>
</#macro>

<#-- Drawn lines of the footnote, as styled runs, every sentence wrapped to the width it is given. -->
<#function footNoteLines data size width singleLine>
	<#local sentences = footNoteSentences(data)>
	<#if singleLine && (sentences?size gt 1)>
	<#local sentences = [{"text": sentences[0].text + " / " + sentences[1].text, "emphasis": sentences[0].emphasis + "," + sentences[1].emphasis}]>
	</#if>
	<#local charsPerLine = singleLine?then(-1, charsPerWidth((width gte 0)?then(width, contentWidth()), size))>
	<#local lines = []>
	<#list sentences as sentence>
	<#local lines = lines + footNoteWrap(sentence, charsPerLine)>
	</#list>
	<#return lines>
</#function>

<#--
  Lines of one footnote sentence, as styled runs. A wording set in the heavy face is never broken
  across two lines, "a little" staying whole: its spaces become no-break spaces before the wrap,
  which only breaks on plain whitespace.
-->
<#function footNoteWrap sentence charsPerLine>
	<#local text = sentence.text>
	<#local emphasis = []>
	<#list sentence.emphasis?split(",") as word>
		<#if word?trim?has_content>
		<#local text = text?replace(word?trim, unbreakable(word))>
		<#local emphasis = emphasis + [unbreakable(word)]>
		</#if>
	</#list>
	<#local lines = (charsPerLine gt 0)?then(wrap(text, charsPerLine), [text])>
	<#local wrapped = []>
	<#list lines as line>
		<#local wrapped = wrapped + [emphasise(line, emphasis?join(","))]>
	</#list>
	<#return wrapped>
</#function>

<#-- The footnote of the panel, one sentence per language, each with the wordings it emphasises. -->
<#function footNoteSentences data>
	<#local sentences = []>
	<#if data.footNote()?has_content>
	<#local sentences = sentences + [{"text": data.footNote(), "emphasis": data.label("footNoteEmphasis")}]>
	</#if>
	<#if data.isBilingual() && data.secondaryFootNote()?has_content>
	<#local sentences = sentences + [{"text": data.secondaryFootNote(), "emphasis": data.secondaryLabel("footNoteEmphasis")}]>
	</#if>
	<#return sentences>
</#function>

<#--
  Geometry of the Canadian standard table, figures 1.1 and 3.1 of the directory of formats of
  Health Canada: a 13 point title, a 9 point serving, calories in 10 point bold, a 6.5 point
  footnote, hairlines of half a point and rules of two and a half points marking out the parts of
  the table. The supplemented food facts table is drawn on the same geometry.
-->
<#assign CA_TITLE_SIZE = 13>
<#assign CA_SERVING_SIZE = 9>
<#assign CA_CALORIES_SIZE = 10>
<#assign CA_FOOTNOTE_SIZE = 6.5>
<#assign CA_HAIRLINE = 0.5>
<#assign CA_RULE_THICK = 2.5>
<#assign CA_INDENT = 6>

<#--
  Leadings of the directory, each measured from the baseline of a line to the baseline of the next
  one, the rule between them included: a nutrient sits 9 points under the line above it when no
  rule parts them, 12 points under a hairline and 14.5 points under a thick rule. The directory
  centres every rule between the two lines it parts.
-->
<#assign CA_SERVING_LEAD = 11>
<#assign CA_SECOND_SERVING_LEAD = 10>
<#assign CA_CALORIES_LEAD = 14.5>
<#assign CA_HEADER_LEAD = 7>
<#assign CA_ROW_LEAD = 9>
<#assign CA_HAIRLINE_LEAD = 12>
<#assign CA_THICK_LEAD = 14.5>
<#assign CA_FOOTNOTE_LEAD = 13>
<#assign CA_FOOTNOTE_NEXT_LEAD = 7.5>
<#assign CA_SUPPLEMENTED_WITH_LEAD = 13.5>
<#assign CA_SUPPLEMENTAL_NOTE_LEAD = 11.5>

<#-- Air the frame keeps under the last line of text, its descender included. -->
<#assign CA_FRAME_INSET = 3>

<#-- Depth of the Arial descender, as a ratio of the font size, to tell where a line of text ends. -->
<#assign DESCENT_RATIO = 0.21>

<#--
  Rule closing the opening block of a Canadian panel. It is lighter than the rules parting the
  panel itself: the regulation marks out the calories, the core nutrients and the minerals with a
  thick rule, and closes the title and the serving on a one point rule.
-->
<#assign CA_RULE_OPENING = 1>

<#--
  Asterisk calling a footnote, which the directory sets apart from the wording it follows: a 9 point
  asterisk in the regular weight, its baseline lowered by 2 points, whatever the size and the weight
  of the wording around it.
-->
<#assign ASTERISK_SIZE = 9>
<#assign ASTERISK_DROP = 2>

<#--
  Mark a supplemented food facts table prints on the caption of its supplemental block and at the
  head of the note explaining it. Figure 1.1 of the directory of supplemented food formats sets it
  in the regular weight and as a superscript: smaller, and raised above the baseline.
-->
<#assign SUPPLEMENT_MARK = "†">
<#assign SUPERSCRIPT_RATIO = 0.7>
<#assign SUPERSCRIPT_RISE = 0.35>
<#-- Advance width of the dagger in Arial, as a ratio of its size: that of a figure. -->
<#assign DIGIT_WIDTH_RATIO = 0.556>

<#-- The mark set as a superscript after the text it closes, in a text of that size. -->
<#macro supplementMark size>
<tspan font-weight="normal" font-size="${size * SUPERSCRIPT_RATIO}" dy="${-size * SUPERSCRIPT_RISE}">${SUPPLEMENT_MARK}</tspan></#macro>

<#--
  A wording with every asterisk it holds set the way the directory sets it. The baseline is brought
  back after the asterisk, so that the wording following it, "% VQ*" after "% DV* / ", stays on its
  line.
-->
<#macro asterisked text>
<#list text?split("*") as part><#if part?index gt 0><tspan font-size="${ASTERISK_SIZE}" font-weight="normal" dy="${ASTERISK_DROP}">*</tspan><#if part?has_content><tspan dy="${-ASTERISK_DROP}" xml:space="preserve">${part}</tspan></#if><#else>${part}</#if></#list><#t>
</#macro>

<#--
  Last baseline a Canadian panel drew on, and the size of the text set on it. Every leading of the
  directory starts from there, and the rule under a line is placed from the depth of its text.
-->
<#assign lastBaseline = 0>
<#assign lastSize = 0>

<#-- Moves the Canadian cursor down to the next baseline, for a text of that size. -->
<#macro advance lead size>
	<#assign lastBaseline = lastBaseline + lead>
	<#assign lastSize = size>
</#macro>

<#--
  Top of a rule centred between the line drawn last and the next one, the space between them
  running from the descender of the first to the cap height of the second.
-->
<#function centredRuleTop nextBaseline nextSize height>
	<#local gapTop = lastBaseline + lastSize * DESCENT_RATIO>
	<#local gapBottom = nextBaseline - nextSize * ASCENT_RATIO>
	<#return (gapTop + gapBottom - height) / 2>
</#function>

<#-- Ordinate the frame closes on, under the line drawn last. -->
<#function canadianBottom>
	<#return lastBaseline + lastSize * DESCENT_RATIO + CA_FRAME_INSET + BORDER>
</#function>

<#--
  Body of a Canadian panel, B.01.401. It parts from the FDA one on three counts: the daily value
  header sits in the calories band instead of taking a line of its own, a rule separates the
  groups of nutrients and not every single line, and the percentages stay in the body face.

  Three of these rules are drawn thick, the regulation marking out the three parts of the panel:
  the calories, closed by a rule ending with their figures so that the daily value header stands
  free, the core nutrients, and the minerals.

  A supplemented food closes on the block of what it was supplemented with, which comes after the
  footnote and not before it: the little/lot rule reads on the table, not on the added ingredients.
  Its footnote and its note are set in the type and leading the format states, given as a hash of
  footNoteSize, footNoteLead, noteSize and noteLead.

  Starts under the baseline the heading ended on, and leaves the ordinate of the frame in cursorY.
-->
<#macro canadianBody data withSupplemental=false geometry={}>
	<#local caloriesBaseline = lastBaseline + CA_CALORIES_LEAD>
	<@rule y=centredRuleTop(caloriesBaseline, CA_CALORIES_SIZE, CA_RULE_OPENING) height=CA_RULE_OPENING/>
	<@caloriesBand data=data base=caloriesBaseline/>
	<@advance lead=CA_CALORIES_LEAD size=CA_CALORIES_SIZE/>

	<@canadianGroup lines=data.nutrients() ruleToX=caloriesRuleEnd(data)/>
	<@canadianGroup lines=data.micronutrients()/>

	<#if data.footNote()?has_content>
	<@canadianFootNote data=data size=geometry.footNoteSize!CA_FOOTNOTE_SIZE firstLead=geometry.footNoteLead!CA_FOOTNOTE_LEAD/>
	</#if>

	<#if withSupplemental && data.hasSupplementalIngredients()>
	<@supplementalBlock data=data noteSize=geometry.noteSize!CA_FOOTNOTE_SIZE noteLead=geometry.noteLead!CA_SUPPLEMENTAL_NOTE_LEAD/>
	</#if>

	<#assign cursorY = canadianBottom()>
</#macro>

<#--
  One group of nutrient lines, opening on a thick rule. Inside it a top level declaration sits under
  a hairline and a nested one, "Saturated", runs on without any rule.

  The rule opening the group spans the panel, unless ruleToX stops it short: the rule closing the
  calories ends with their figures.
-->
<#macro canadianGroup lines ruleToX=-1>
	<#list lines as line>
	<#if line?is_first>
	<@ruledRow line=line lead=CA_THICK_LEAD ruleHeight=CA_RULE_THICK ruleToX=ruleToX/>
	<#elseif (line.indentLevel() lte 1)>
	<@ruledRow line=line lead=CA_HAIRLINE_LEAD ruleHeight=CA_HAIRLINE/>
	<#else>
	<@ruledRow line=line lead=CA_ROW_LEAD ruleHeight=0/>
	</#if>
	</#list>
</#macro>

<#-- A nutrient line of a Canadian panel, under the rule parting it from the line above, if any. -->
<#macro ruledRow line lead ruleHeight ruleToX=-1>
	<#local base = lastBaseline + lead>
	<#if (ruleHeight gt 0)>
	<@rule y=centredRuleTop(base, NUTRIENT_SIZE, ruleHeight) height=ruleHeight toX=ruleToX/>
	</#if>
	<@nutrientRowAt line=line base=base boldPercent=false indent=CA_INDENT percentShift=line.hasSharedDailyValue()?then(CA_ROW_LEAD / 2, 0)/>
	<@advance lead=lead size=NUTRIENT_SIZE/>
</#macro>

<#--
  Calories of a Canadian panel, with the daily value header pinned to the right of the same line.
  A bilingual table states the header of its first language on the line of the calories and the
  one of its second language right under it, beside the rule closing the calories, which is how
  figure 3.1 of the directory of formats sets them.
-->
<#macro caloriesBand data base>
	<#if data.calories()??>
	<text x="${PAD}" y="${base}" font-weight="${HEAVY_WEIGHT}" font-size="${CA_CALORIES_SIZE}">${caloriesText(data)}</text>
	</#if>
	<#list dailyValueHeaders(data) as header>
	<text x="${right()}" y="${base + header?index * CA_HEADER_LEAD}" font-size="${CAPTION_SIZE}" font-weight="${HEAVY_WEIGHT}" text-anchor="end"><@asterisked text=header/></text>
	</#list>
</#macro>

<#-- "Calories 230", as the calories line of a Canadian panel states it. -->
<#function caloriesText data>
	<#return data.calories().label() + (data.calories().value()??)?then(" " + data.calories().value(), "")>
</#function>

<#--
  Abscissa the thick rule closing the calories ends on: right after their figures, the directory
  never running it across the table. A panel without calories closes on a rule to the middle.
-->
<#function caloriesRuleEnd data>
	<#if data.calories()??>
	<#return PAD + heavyWidth(caloriesText(data), CA_CALORIES_SIZE)>
	</#if>
	<#return PAD + contentWidth() / 2>
</#function>

<#--
  Width a Canadian panel needs, never less than the minimum its format states. The calories and
  the daily value header share one line, and the header is where the wording varies most from one
  language to the next: "% valeur quotidienne*" runs half again as long as "% Daily Value*" and
  would be printed over the calories at the width the English panel needs.
-->
<#function canadianWidth data minimum>
	<#local caloriesWording = (data.calories()??)?then(caloriesText(data), "")>
	<#local headerWidth = 0>
	<#list dailyValueHeaders(data) as header>
		<#local headerWidth = [headerWidth, header?length * CAPTION_SIZE * HEAVY_GLYPH_RATIO]?max>
	</#list>
	<#local needed = 2 * PAD + caloriesWording?length * CA_CALORIES_SIZE * HEAVY_GLYPH_RATIO + CAPTION_SIZE + headerWidth>
	<#return [minimum, needed?ceiling]?max>
</#function>

<#--
  Opening block of a Canadian panel: the title and the serving, each stated once per language.

  The title is set in the largest type of the panel, on a single line per language, but is not
  condensed to its width, which is what the directory of formats figures and what keeps the two
  languages the same size. Its lines run a point apart more than its size, 14 points for a 13 point
  title, which is the leading of every figure of the directory.

  The serving sits servingLead under the title and the serving of the second language
  secondServingLead under the first one. Leaves the last baseline in lastBaseline.
-->
<#macro canadianHeading data y titleSize=CA_TITLE_SIZE servingSize=CA_SERVING_SIZE x=PAD titleKey="title"
		servingLead=CA_SERVING_LEAD secondServingLead=CA_SECOND_SERVING_LEAD>
	<#assign lastBaseline = baseline(y, titleSize) - titleSize - 1>
	<#list panelWordings(data, titleKey) as title>
	<@advance lead=titleSize + 1 size=titleSize/>
	<text x="${x}" y="${lastBaseline}" font-weight="${HEAVY_WEIGHT}" font-size="${titleSize}">${title}</text>
	</#list>

	<@advance lead=servingLead size=servingSize/>
	<text x="${x}" y="${lastBaseline}" font-size="${servingSize}">${data.label("servingSize")}<#if data.serving().servingSize()??> ${data.serving().servingSize()}</#if></text>
	<#if data.isBilingual()>
	<@advance lead=secondServingLead size=servingSize/>
	<text x="${x}" y="${lastBaseline}" font-size="${servingSize}">${data.secondaryLabel("servingSize")}<#if data.secondary().hasServingSize()> ${data.secondary().servingSize()}<#elseif data.serving().servingSize()??> ${data.serving().servingSize()}</#if></text>
	</#if>
</#macro>

<#--
  Width a panel needs to set its title on a single line in every language at the size its format
  states. A title that wraps reads as two titles, which the wording of a supplemented food is long
  enough to provoke, and a title set smaller than the format states is not the format any more.
-->
<#function titleWidth data key size>
	<#local widest = 0>
	<#list panelWordings(data, key) as title>
	<#local widest = [widest, heavyWidth(title, size)]?max>
	</#list>
	<#return (2 * PAD + widest)?ceiling>
</#function>

<#--
  Footnote of a Canadian panel, under a thick rule: its first line firstLead under the last
  nutrient, the next ones nextLead apart, each sentence opening on the asterisk the directory sets.

  A panel drawn across the package states both languages on one line, parted by a slash, gives the
  column the footnote runs under in indent, and closes each of its columns on a rule of its own,
  given in ruleWidths as hashes of x and width, as thick as its format states in ruleHeight.
-->
<#macro canadianFootNote data size firstLead nextLead=CA_FOOTNOTE_NEXT_LEAD indent=PAD width=-1 singleLine=false ruleWidths=[] ruleHeight=CA_RULE_THICK>
	<#local lead = firstLead>
	<#list footNoteLines(data, size, width, singleLine) as segments>
	<#if segments?is_first>
	<#local base = lastBaseline + lead>
	<#local ruleTop = centredRuleTop(base, size, ruleHeight)>
	<#if ruleWidths?has_content>
	<#list ruleWidths as band>
	<@bandRule x=band.x y=ruleTop width=band.width height=ruleHeight/>
	</#list>
	<#else>
	<@rule y=ruleTop height=ruleHeight/>
	</#if>
	</#if>
	<@advance lead=lead size=size/>
	<@styledLineAt segments=segments base=lastBaseline size=size indent=indent asterisks=true/>
	<#local lead = nextLead>
	</#list>
</#macro>

<#--
  Ingredients a supplemented food was supplemented with, SOR/2022-143. They are declared in a
  block of their own, under the caption the regulation words, so that the reader tells them from
  what the food contains on its own.

  The caption is set like the declaration of a nutrient and not like a caption: the regulation
  gives it the weight of the Sodium or the Protein line. It carries the mark of the block, which
  the closing note explains: the amount declared for an ingredient is the amount the food holds,
  and not only what was added to it.
-->
<#macro supplementalBlock data noteSize=CA_FOOTNOTE_SIZE noteLead=CA_SUPPLEMENTAL_NOTE_LEAD>
	<#local captionBaseline = lastBaseline + CA_SUPPLEMENTED_WITH_LEAD>
	<@rule y=centredRuleTop(captionBaseline, NUTRIENT_SIZE, CA_RULE_THICK) height=CA_RULE_THICK/>
	<@advance lead=CA_SUPPLEMENTED_WITH_LEAD size=NUTRIENT_SIZE/>
	<text x="${PAD}" y="${lastBaseline}" font-size="${NUTRIENT_SIZE}" font-weight="${HEAVY_WEIGHT}">${joined(data.label("supplementedWith"), data.isBilingual()?then(data.secondaryLabel("supplementedWith"), ""))}<@supplementMark size=NUTRIENT_SIZE/></text>

	<#list data.supplementalIngredients() as line>
	<@ruledRow line=line lead=CA_HAIRLINE_LEAD ruleHeight=CA_HAIRLINE/>
	</#list>

	<@supplementalNote data=data size=noteSize firstLead=noteLead/>
</#macro>

<#--
  Note closing the supplemental block, under a hairline, stated once per language the panel is
  written in and opening on the mark of the declarations it explains, so that the reader ties the
  two together.
-->
<#macro supplementalNote data size firstLead>
	<#local markSize = size * SUPERSCRIPT_RATIO>
	<#local markWidth = markSize * DIGIT_WIDTH_RATIO>
	<#local notes = panelWordings(data, "supplementedNote")>
	<#if !notes?has_content>
	<@closingHairline/>
	</#if>
	<#local lead = firstLead>
	<#list notes as note>
	<#list wrap(note, charsPerWidth(contentWidth() - markWidth, size)) as noteLine>
	<#if note?is_first && noteLine?is_first>
	<@rule y=centredRuleTop(lastBaseline + lead, size, CA_HAIRLINE) height=CA_HAIRLINE/>
	</#if>
	<@advance lead=lead size=size/>
	<#if noteLine?is_first>
	<text x="${PAD}" y="${lastBaseline - size * SUPERSCRIPT_RISE}" font-size="${markSize}">${SUPPLEMENT_MARK}</text>
	</#if>
	<text x="${PAD + markWidth}" y="${lastBaseline}" font-size="${size}">${noteLine}</text>
	<#local lead = CA_FOOTNOTE_NEXT_LEAD>
	</#list>
	</#list>
</#macro>

<#-- Hairline closing the last ingredient of a block no note follows, the frame closing under it. -->
<#macro closingHairline>
	<#local top = lastBaseline + lastSize * DESCENT_RATIO + 1>
	<@rule y=top height=CA_HAIRLINE/>
	<#assign lastBaseline = top + CA_HAIRLINE>
	<#assign lastSize = 0>
</#macro>

<#-- A fixed wording of the panel in every language it is written in, empty ones left out. -->
<#function panelWordings data key>
	<#local notes = []>
	<#if data.label(key)?has_content>
	<#local notes = notes + [data.label(key)]>
	</#if>
	<#if data.isBilingual() && data.secondaryLabel(key)?has_content>
	<#local notes = notes + [data.secondaryLabel(key)]>
	</#if>
	<#return notes>
</#function>

<#-- Footnote of a panel, wrapped to the width it is given. -->
<#macro footNote text y width=-1 x=PAD anchor="start" size=FOOTNOTE_SIZE>
	<#local available = (width gte 0)?then(width, contentWidth())>
	<#assign cursorY = y>
	<#list wrap(text, charsPerWidth(available, size)) as footNoteLine>
	<text x="${x}" y="${baseline(cursorY, size)}" font-size="${size}"<#if anchor != "start"> text-anchor="${anchor}"</#if>>${footNoteLine}</text>
	<#assign cursorY = cursorY + lineHeight(size)>
	</#list>
</#macro>

<#--
  Body of the dual column format, 21 CFR 101.9(e)(6)(i): the same nutrients, but two columns of
  figures, one per serving and one per container, each with its own amount and percentage.
  Required when a container holds a small number of servings and could be eaten in one go.

  The two columns are strictly of the same width and are separated from the wording, and from
  each other, by a vertical rule: with four columns of figures, nothing else tells the reader
  which figure belongs to which serving. Each amount starts just after the rule opening its
  column and each percentage ends just before the next one, air kept on both sides of the rule.
-->
<#macro dualColumnBody data y labelW=100 footNoteSize=FOOTNOTE_SIZE>
	<#assign cursorY = y>
	<#local columnW = (W - PAD - labelW) / 2>
	<#local servingValueX = labelW + CELL_INSET>
	<#local servingPercentX = labelW + columnW - CELL_INSET>
	<#local containerValueX = labelW + columnW + CELL_INSET>
	<#local containerPercentX = labelW + 2 * columnW - CELL_INSET>

	<@rule y=cursorY height=RULE_THICK/>
	<#assign cursorY = cursorY + RULE_THICK + CAPTION_LEAD>
	<#local columnsTop = cursorY>

	<text x="${labelW + columnW / 2}" y="${baseline(cursorY, CAPTION_SIZE)}" font-size="${CAPTION_SIZE}" font-weight="${HEAVY_WEIGHT}" text-anchor="middle">${data.label("perServing")}</text>
	<text x="${labelW + columnW + columnW / 2}" y="${baseline(cursorY, CAPTION_SIZE)}" font-size="${CAPTION_SIZE}" font-weight="${HEAVY_WEIGHT}" text-anchor="middle">${data.label("perContainer")}</text>
	<#assign cursorY = cursorY + CAPTION_ROW_H>

	<#if data.calories()??>
	<text x="${PAD}" y="${baseline(cursorY, CALORIES_LABEL_SIZE)}" font-weight="${HEAVY_WEIGHT}" font-size="${CALORIES_LABEL_SIZE}">${data.calories().label()}</text>
	<#if data.calories().value()??>
	<text x="${servingPercentX}" y="${baseline(cursorY, CALORIES_LABEL_SIZE)}" font-weight="${HEAVY_WEIGHT}" font-size="${CALORIES_LABEL_SIZE}" text-anchor="end">${data.calories().value()}</text>
	</#if>
	<#if data.calories().valuePerContainer()??>
	<text x="${containerPercentX}" y="${baseline(cursorY, CALORIES_LABEL_SIZE)}" font-weight="${HEAVY_WEIGHT}" font-size="${CALORIES_LABEL_SIZE}" text-anchor="end">${data.calories().valuePerContainer()}</text>
	</#if>
	<#assign cursorY = cursorY + lineHeight(CALORIES_LABEL_SIZE)>
	</#if>

	<@dualColumnRule y=cursorY labelW=labelW columnW=columnW height=RULE_MEDIUM/>
	<#assign cursorY = cursorY + RULE_MEDIUM + CAPTION_LEAD>

	<text x="${servingPercentX}" y="${baseline(cursorY, CAPTION_SIZE)}" font-size="${CAPTION_SIZE}" font-weight="${HEAVY_WEIGHT}" text-anchor="end">${data.label("dailyValueShort")}</text>
	<text x="${containerPercentX}" y="${baseline(cursorY, CAPTION_SIZE)}" font-size="${CAPTION_SIZE}" font-weight="${HEAVY_WEIGHT}" text-anchor="end">${data.label("dailyValueShort")}</text>
	<#assign cursorY = cursorY + CAPTION_ROW_H + 1>

	<#list data.nutrients() as line>
	<@dualColumnRule y=cursorY labelW=labelW columnW=columnW fromX=ruleStart(line)/>
	<#assign cursorY = cursorY + HAIRLINE>
	<@dualColumnRow line=line y=cursorY servingValueX=servingValueX servingPercentX=servingPercentX
		containerValueX=containerValueX containerPercentX=containerPercentX/>
	<#assign cursorY = cursorY + NUTRIENT_ROW_H>
	</#list>

	<#if data.micronutrients()?has_content>
	<@dualColumnRule y=cursorY labelW=labelW columnW=columnW height=RULE_THICK/>
	<#assign cursorY = cursorY + RULE_THICK>
	<#list data.micronutrients() as line>
	<#if (line?index gt 0)>
	<@dualColumnRule y=cursorY labelW=labelW columnW=columnW/>
	<#assign cursorY = cursorY + HAIRLINE>
	</#if>
	<@dualColumnRow line=line y=cursorY servingValueX=servingValueX servingPercentX=servingPercentX
		containerValueX=containerValueX containerPercentX=containerPercentX boldPercent=false/>
	<#assign cursorY = cursorY + NUTRIENT_ROW_H>
	</#list>
	</#if>

	<@columnRule x=labelW fromY=columnsTop toY=cursorY/>
	<@columnRule x=labelW + columnW fromY=columnsTop toY=cursorY/>

	<#if data.footNote()?has_content>
	<@rule y=cursorY height=RULE_MEDIUM/>
	<#assign cursorY = cursorY + RULE_MEDIUM + 1>
	<@footNote text=data.footNote() y=cursorY size=footNoteSize/>
	</#if>

	<#assign cursorY = cursorY + BORDER + 1>
</#macro>

<#--
  Rule across the wording and the two columns of figures, broken on each side of the vertical
  rules the way the FDA figure draws it: each vertical rule then runs on unbroken from the column
  headers down to the last vitamin.
-->
<#macro dualColumnRule y labelW columnW height=HAIRLINE fromX=PAD>
	<#list [[fromX, labelW], [labelW, labelW + columnW], [labelW + columnW, W - PAD]] as span>
	<#local start = (span?index == 0)?then(span[0], span[0] + COLUMN_RULE_GAP)>
	<#local end = (span?is_last)?then(span[1], span[1] - COLUMN_RULE_GAP)>
	<@bandRule x=start y=y width=end - start height=height/>
	</#list>
</#macro>

<#--
  One nutrient across the four columns of figures. The name is printed alone, its amount going
  to the serving column, so that nothing overlaps whatever the length of the wording. The
  abbreviated wording is what fits the narrower label column, "Incl. Added Sugars" being the
  case the FDA spells out.
-->
<#macro dualColumnRow line y servingValueX servingPercentX containerValueX containerPercentX boldPercent=true>
	<#local top = y + 2>
	<#local base = baseline(top, NUTRIENT_SIZE)>
	<#local x = PAD + (line.indentLevel() - 1) * INDENT>
	<text x="${x}" y="${base}" font-size="${NUTRIENT_SIZE}"<#if line.bold()> font-weight="${HEAVY_WEIGHT}"</#if>><@wording text=line.columnLabel()/></text>
	<#if line.value()??>
	<text x="${servingValueX}" y="${base}" font-size="${NUTRIENT_SIZE}">${line.value()}</text>
	</#if>
	<#if line.hasDailyValue()>
	<text x="${servingPercentX}" y="${base}" font-size="${NUTRIENT_SIZE}"<#if boldPercent> font-weight="${HEAVY_WEIGHT}"</#if> text-anchor="end">${line.dailyValuePercent()}</text>
	</#if>
	<#if line.valuePerContainer()??>
	<text x="${containerValueX}" y="${base}" font-size="${NUTRIENT_SIZE}">${line.valuePerContainer()}</text>
	</#if>
	<#if line.hasDailyValuePerContainer()>
	<text x="${containerPercentX}" y="${base}" font-size="${NUTRIENT_SIZE}"<#if boldPercent> font-weight="${HEAVY_WEIGHT}"</#if> text-anchor="end">${line.dailyValuePercentPerContainer()}</text>
	</#if>
</#macro>

<#--
  Run-on sentence of the US linear format, 21 CFR 101.9(j)(13)(ii)(A)(2). Nutrients are named by
  their regulated abbreviation and their percentage is parenthesised, the whole panel being a
  single paragraph rather than a table.

  It is returned as styled segments and not as a string: the name of a mandatory nutrient is set
  in the heavy face while its figures stay in the body face, which a single text run cannot express.
-->
<#function linearSegments data last=".">
	<#local declarations = linearDeclarations(data)>
	<#local segments = []>
	<#list declarations as declaration>
		<#local segments = segments + [declaration.name, text(declaration.figures + (declaration?is_last)?then(last, ","))]>
	</#list>
	<#return segments>
</#function>

<#--
  Declarations of the US linear sentence, each a styled name and the figures that follow it.

  Only the nutrients the regulation emphasises in a column format keep the heavy face, and a name
  never breaks across two lines. A vitamin or a mineral is stated by its percentage alone, "Vit. D
  (4% DV)". A line whose wording embeds its amount goes inside the parenthesis of the line above
  it, "Total Sugars 12g (Incl. 10g Added Sugars, 20% DV)", which is how the FDA words it.
-->
<#function linearDeclarations data>
	<#local lines = data.nutrients() + data.micronutrients()>
	<#local declarations = []>
	<#list lines as line>
		<#if !line.valueInLabel()>
		<#local nested = (line?has_next && lines[line?index + 1].valueInLabel())?then(lines[line?index + 1], "")>
		<#local isMicronutrient = line?index gte data.nutrients()?size>
		<#local name = unbreakable(line.plainAbbreviatedLabel())>
		<#local declarations = declarations + [{"name": line.bold()?then(emphasis(name), text(name)),
			"figures": linearFigures(data, line, nested, isMicronutrient)}]>
		</#if>
	</#list>
	<#return declarations>
</#function>

<#-- Amount and parenthesis following a nutrient name in the US linear sentence. -->
<#function linearFigures data line nested isMicronutrient>
	<#local figures = (!isMicronutrient && line.value()??)?then(" " + line.value(), "")>
	<#local inParenthesis = []>
	<#if nested?has_content>
		<#local inParenthesis = inParenthesis + [nested.abbreviatedLabel() + nested.hasDailyValue()?then(", " + dailyValueStatement(data, nested), "")]>
	<#elseif line.hasDailyValue()>
		<#local inParenthesis = inParenthesis + [dailyValueStatement(data, line)]>
	</#if>
	<#return figures + (inParenthesis?size gt 0)?then(" (" + inParenthesis?join(", ") + ")", "")>
</#function>

<#-- Percentage of a line followed by what names it, "20% DV". -->
<#function dailyValueStatement data line>
	<#return line.dailyValuePercent() + dailyValueSuffix(data)>
</#function>

<#--
  Sentence of the Canadian linear format, one group of lines at a time, which is how it states its
  declaration in the four lines the regulation fixes. Every nutrient name is in the heavy face and
  every amount is stated, vitamins and minerals included.

  A percentage covering two nutrients is stated after the second of them, "Lipides saturés 1 g +
  trans 0 g (5 %)": read after the first one it would look like the percentage of that one alone,
  and no comma parts the two nutrients it covers.

  A declaration is never broken across two lines: its name, its amount and its percentage are
  glued together, the line breaking before a nutrient and never inside its declaration.
-->
<#function linearGroupSegments data lines last=".">
	<#local segments = []>
	<#local carried = "">
	<#list lines as line>
		<#local segments = segments + [emphasis(unbreakable(line.plainAbbreviatedLabel()))]>
		<#local figures = "">
		<#if line.value()??><#local figures = " " + line.value()></#if>
		<#if line.hasSharedDailyValue()>
			<#local carried = percentIn(data, line)>
		<#else>
			<#if line.hasDailyValue()><#local figures = figures + percentIn(data, line)></#if>
			<#local figures = figures + carried>
			<#local carried = "">
		</#if>
		<#local closing = line.hasSharedDailyValue()?then("", (line?is_last)?then(last, ","))>
		<#local segments = segments + [glued(figures + closing)]>
	</#list>
	<#return segments>
</#function>

<#-- Parenthesised percentage of a line, as a linear panel states it. -->
<#function percentIn data line>
	<#return " (" + dailyValueStatement(data, line) + ")">
</#function>

<#--
  Lines of a panel picked by nutrient code, in the order the codes are given. A code the product
  does not declare is simply absent, which is what lets a format state the fixed order of the
  regulation without assuming every nutrient of it is on the label.
-->
<#function linesByCode lines codes>
	<#local selected = []>
	<#list codes as code>
		<#list lines as line>
			<#if line.nutCode() == code>
			<#local selected = selected + [line]>
			</#if>
		</#list>
	</#list>
	<#return selected>
</#function>

<#-- Lines none of the given codes names, so that an optional nutrient is never left undeclared. -->
<#function linesOutside lines codes>
	<#local remaining = []>
	<#list lines as line>
		<#if !codes?seq_contains(line.nutCode())>
		<#local remaining = remaining + [line]>
		</#if>
	</#list>
	<#return remaining>
</#function>

<#--
  What closes a parenthesised percentage in a linear panel. The FDA names the daily value inside
  the parenthesis, "(5% DV)", where Canada states the bare percentage and explains it in a legend
  at the foot of the panel.
-->
<#function dailyValueSuffix data>
	<#return data.label("dailyValueSuffix")?has_content?then(" " + data.label("dailyValueSuffix"), "")>
</#function>

<#-- A run of text set in the body face, as the flowing paragraph of a linear panel takes it. -->
<#function text value>
	<#return {"text": value, "bold": false}>
</#function>

<#-- A run of text set in the body face that a wrapped line never parts from the run before it. -->
<#function glued value>
	<#return {"text": value, "bold": false, "glued": true}>
</#function>

<#-- A run of text set in the heavy face. -->
<#function emphasis value>
	<#return {"text": value, "bold": true}>
</#function>

<#-- The same run set at another size than the paragraph, the calories of a linear panel. -->
<#function sized segment size>
	<#return segment + {"size": size}>
</#function>

<#-- Text whose words a wrapped line must keep together, a nutrient name or a whole declaration. -->
<#function unbreakable value>
	<#return value?trim?replace(" ", NBSP)>
</#function>

<#-- Linear statement of the servings, "Servings: 8", or the column wording when none is declared. -->
<#function linearServings data>
	<#if data.label("servingsShort")?has_content>
	<#return data.label("servingsShort") + " " + data.serving().servingsPerContainer()>
	</#if>
	<#return data.serving().servingsPerContainer() + " " + data.label("servingsPerContainer")>
</#function>

<#-- Linear statement of the serving size, "Serv. size: 2/3 cup (56g)". -->
<#function linearServingSize data>
	<#local wording = data.label("servingSizeShort")?has_content?then(data.label("servingSizeShort"), data.label("servingSize"))>
	<#return wording + " " + data.serving().servingSize()>
</#function>

<#--
  Paragraph of styled runs, wrapped to the width of the panel, or to the width it is given. The
  runs are broken into words so that a line ends between two words and never in the middle of one,
  whatever the styling, and the words of a glued run stay on the line of the word before them.
-->
<#macro paragraph segments y size=NUTRIENT_SIZE indent=PAD width=-1>
	<#local charsPerLine = charsPerWidth((width gte 0)?then(width, W - PAD - indent), size, FIGURE_GLYPH_RATIO)>
	<#local line = []>
	<#local length = 0>
	<#assign cursorY = y>
	<#list wordGroups(segmentWords(segments, size)) as group>
		<#local groupLength = groupWidth(group)>
		<#if (length gt 0) && (length + 1 + groupLength gt charsPerLine)>
		<@paragraphLine parts=line y=cursorY size=size indent=indent/>
		<#assign cursorY = cursorY + lineHeight(largestSize(line))>
		<#local line = []>
		<#local length = 0>
		</#if>
		<#local line = line + group>
		<#local length = length + (length gt 0)?then(1, 0) + groupLength>
	</#list>
	<#if (line?size gt 0)>
	<@paragraphLine parts=line y=cursorY size=size indent=indent/>
	<#assign cursorY = cursorY + lineHeight(largestSize(line))>
	</#if>
</#macro>

<#-- Words a line can only take together, a word glued to the one before it joining its group. -->
<#function wordGroups words>
	<#local groups = []>
	<#list words as word>
		<#if word.glued && (groups?size gt 0)>
		<#local groups = groups[0..*(groups?size - 1)] + [groups?last + [word]]>
		<#else>
		<#local groups = groups + [[word]]>
		</#if>
	</#list>
	<#return groups>
</#function>

<#-- Width a group of words takes on a line, the spaces between them included. -->
<#function groupWidth group>
	<#local width = group?size - 1>
	<#list group as word>
		<#local width = width + word.width>
	</#list>
	<#return width>
</#function>

<#-- Size of the largest word of a drawn line, which the whole line is laid out on. -->
<#function largestSize parts>
	<#local largest = 0>
	<#list parts as part>
		<#local largest = [largest, part.size]?max>
	</#list>
	<#return largest>
</#function>

<#--
  One drawn line of a paragraph, the heavy runs being the only ones carrying a tspan.

  xml:space is preserved because the spaces between two runs are the only thing separating the
  words: the default handling drops a text node holding nothing but a space, which is exactly
  what sits between two emphasised words.
-->
<#macro paragraphLine parts y size indent>
	<text x="${indent}" y="${baseline(y, largestSize(parts))}" font-size="${size}" xml:space="preserve"><#list mergedRuns(parts) as run><#if (run?index gt 0)> </#if><#if run.bold || (run.size != size)><tspan<#if run.bold> font-weight="${HEAVY_WEIGHT}"</#if><#if run.size != size> font-size="${run.size}"</#if>><@wording text=run.text/></tspan><#else><@wording text=run.text/></#if></#list></text>
</#macro>

<#-- Words of one line gathered back into as few runs as their styling allows. -->
<#function mergedRuns parts>
	<#local runs = []>
	<#list parts as part>
		<#if (runs?size gt 0) && (runs?last.bold == part.bold) && (runs?last.size == part.size)>
		<#local runs = runs[0..*(runs?size - 1)] + [{"text": runs?last.text + " " + part.text, "bold": part.bold, "size": part.size}]>
		<#else>
		<#local runs = runs + [{"text": part.text, "bold": part.bold, "size": part.size}]>
		</#if>
	</#list>
	<#return runs>
</#function>

<#--
  Words of a run of styled segments, each keeping the styling and the size of the segment it comes
  from and carrying the width it takes, counted in glyphs of the body face at the size of the
  paragraph so that one wrap can measure a line whatever the faces and the sizes it mixes.
-->
<#function segmentWords segments size>
	<#local words = []>
	<#list segments as segment>
		<#local wordSize = segment.size!size>
		<#local ratio = segment.bold?then(HEAVY_GLYPH_RATIO / FIGURE_GLYPH_RATIO, 1) * wordSize / size>
		<#list segment.text?trim?split(r"\s+", "r") as word>
			<#if (word?length gt 0)>
			<#local words = words + [{"text": word, "bold": segment.bold, "size": wordSize, "width": word?length * ratio, "glued": segment.glued!false}]>
			</#if>
		</#list>
	</#list>
	<#return words>
</#function>

<#--
  A wording, the word the regulation italicises set in italics when it stands as a word of its
  own: "Trans Fat" gets it, a word merely containing those letters does not.
-->
<#macro wording text>
	<#local at = ITALIC_WORD?has_content?then(text?index_of(ITALIC_WORD), -1)>
	<#if (at gte 0) && isWholeWord(text, at)>${text[0..<at]}<tspan font-style="italic">${ITALIC_WORD}</tspan>${text[(at + ITALIC_WORD?length)..]}<#else>${text}</#if><#t>
</#macro>

<#-- Tells whether the italicised word found at that index stands between two non letters. -->
<#function isWholeWord text at>
	<#local end = at + ITALIC_WORD?length>
	<#return ((at == 0) || !text[at - 1]?matches(r"\p{L}")) && ((end == text?length) || !text[end]?matches(r"\p{L}"))>
</#function>

<#-- The svg envelope, identical for every format: white ground, border, then the drawn body. -->
<#macro panel height>
<@svg.document width=W height=height ground="#ffffff" fontFamily=FONT_FAMILY>
	<@border height=height/>
	<#nested>
</@svg.document>
</#macro>

<#--
  One nutrient of the tabular format, 21 CFR 101.9(d)(11)(iii), the wording and the percentage
  sitting at the two ends of a column. A format setting its columns in a smaller type, the
  Canadian horizontal one, gives the size and the height of the row, a percentage covering two
  lines being dropped by half the height of the second one.
-->
<#macro tabularRow line y labelX percentX boldPercent=true size=NUTRIENT_SIZE rowHeight=NUTRIENT_ROW_H>
	<#local base = baseline(y + 2, size)>
	<#local x = labelX + (line.indentLevel() - 1) * INDENT>
	<text x="${x}" y="${base}" font-size="${size}"<#if line.bold()> font-weight="${HEAVY_WEIGHT}"</#if>><@wording text=line.label()/><#if line.printsValue()> <tspan font-weight="normal">${line.value()}</tspan></#if></text>
	<#if line.hasDailyValue()>
	<text x="${percentX}" y="${base + line.hasSharedDailyValue()?then(rowHeight / 2, 0)}" font-size="${size}"<#if boldPercent> font-weight="${HEAVY_WEIGHT}"</#if> text-anchor="end">${line.dailyValuePercent()}</text>
	</#if>
</#macro>

<#-- Greedy word wrap, by character count, the footnote being the only free text of a panel. -->
<#function wrap text charsPerLine>
	<#return svg.wrap(text, charsPerLine)>
</#function>
