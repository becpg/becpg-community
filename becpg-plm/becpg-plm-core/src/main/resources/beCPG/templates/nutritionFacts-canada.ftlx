<#--
  Canadian nutrition facts panel, B.01.401.

  Its opening block is a single "Per <serving>" line instead of the two lines of the FDA one,
  and its footnote states the little/lot rule rather than the daily diet disclaimer. The
  wording follows the locale, so the same template renders "Valeur nutritive" in French and
  "Nutrition Facts" in English.

  Known gap: the regulation prints a single % daily value shared by "Saturated + Trans", which
  this template still shows as two independent lines.
-->
<#import "nutritionFacts-lib.ftlx" as nf>

<#assign y = nf.BORDER + 2>
<#assign body>

	<@nf.title text=nf_data.label("title") y=y/>
	<#assign y = y + nf.TITLE_SIZE>

	<@nf.rule y=y/>
	<#assign y = y + nf.HAIRLINE + 1>

	<text x="${nf.PAD}" y="${nf.baseline(y, nf.SERVING_SIZE)}" font-size="${nf.SERVING_SIZE}" font-weight="bold">${nf_data.label("servingSize")}<#if nf_data.serving().servingSize()??> ${nf_data.serving().servingSize()}</#if></text>
	<#assign y = y + nf.SERVING_ROW_H>

	<@nf.panelBody data=nf_data y=y/>
</#assign>
<@nf.panel height=nf.cursorY>${body}</@nf.panel>
